-if(CMAKE_SYSTEM_NAME STREQUAL "Linux" OR CMAKE_SYSTEM_NAME STREQUAL "FreeBSD")
+if(CMAKE_SYSTEM_NAME STREQUAL "Linux" OR CMAKE_SYSTEM_NAME STREQUAL "FreeBSD" OR CMAKE_SYSTEM_NAME STREQUAL "OpenBSD")
     set(LIBVIRTUALHID_USES_THREADS ON)
 endif()
 set(LIBVIRTUALHID_USES_XTEST OFF)
@@ -161,9 +161,12 @@ if(LIBVIRTUALHID_INSTALL)
     set(LIBVIRTUALHID_CONFIG_DEPENDENCIES "")
