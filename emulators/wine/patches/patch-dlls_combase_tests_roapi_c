-static void flush_events(void)
+static DWORD wait_for_thread(HANDLE thread)
 {
-    int diff = 200;
-    DWORD time;
+    DWORD ret;
     MSG msg;
 
-    time = GetTickCount() + diff;
-    while (diff > 0)
