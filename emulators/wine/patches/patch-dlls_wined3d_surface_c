     TRACE("Colour blit.\n");
 
+    /* OpenGL overlapping image copies are undefined. Use the CPU blitter
+     * for plain copies; llvmpipe's overlapping memcpy aborts on OpenBSD. */
+    if (!scale && !(flags & ~WINED3D_BLT_RAW)
