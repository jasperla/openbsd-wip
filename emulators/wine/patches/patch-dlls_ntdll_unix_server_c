 /***********************************************************************
+ *           system_apc_thread
+ */
+static void WINAPI system_apc_thread( void *arg )
+{
+    NTSTATUS status = STATUS_SUCCESS;
+    int fd = (ULONG_PTR)arg;
+    ssize_t ret;
+
+    while ((ret = write( fd, &status, sizeof(status) )) < 0 && errno == EINTR);
+    close( fd );
+    if (ret != sizeof(status))
+        fatal_error( "cannot signal system APC readiness\n" );
+
+    for (;;)
+    {
+        status = server_select( NULL, 0, SELECT_SYSTEM, TIMEOUT_INFINITE, NULL, NULL );
+        if (status)
+            fatal_error( "system APC wait failed, status %x\n", status );
+    }
+}
+
+
+/***********************************************************************
+ *           start_system_apc_thread
+ */
+static void start_system_apc_thread(void)
+{
+    HANDLE thread;
+    NTSTATUS status;
+    int fds[2];
+    ssize_t ret;
+
+    if (server_pipe( fds ) == -1)
+        fatal_error( "cannot create system APC ready pipe\n" );
+    status = PsCreateSystemThread( &thread, SYNCHRONIZE, NULL, NULL, NULL,
+      system_apc_thread, (void *)(ULONG_PTR)fds[1] );
+    if (status)
+        fatal_error( "cannot create system APC thread, status %x\n", status );
+
+    /* Wait outside wineserver: the initial Windows thread may be suspended. */
+    while ((ret = read( fds[0], &status, sizeof(status) )) < 0 && errno == EINTR);
+    close( fds[0] );
+    NtClose( thread );
+    if (ret != sizeof(status))
+        fatal_error( "cannot read system APC readiness\n" );
+    if (status)
+        fatal_error( "system APC thread failed to initialize, status %x\n", status );
+}
