+
+/* Re-evaluate the next recipient after removing a hardware message. */
+static void wake_next_hardware_message( struct msg_queue *queue )
+{
+    struct thread_input *input = queue->input;
+    struct message *msg;
+    struct thread *thread;
+    user_handle_t win;
+    unsigned int msg_code;
+
+    LIST_FOR_EACH_ENTRY( msg, &input->msg_list, struct message, entry )
+    {
+        win = find_hardware_message_window( input->desktop, input, msg, &msg_code, &thread );
+        if (!thread) continue;
+        if (win && thread->queue->input == input)
+        {
+            if (thread->queue != queue) set_queue_bits( thread->queue, get_hardware_msg_bit( msg->msg ) );
+            release_object( thread );
+            break;
+        }
+        release_object( thread );
+    }
 }
 
