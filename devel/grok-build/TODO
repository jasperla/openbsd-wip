## Package rebuild / install

  doas -u _pbuild make -C /usr/ports/openbsd-wip/devel/grok-build package \
    PKG_CREATE_NO_CHECKS=warn
  # fat box:
  doas -u _pbuild make GROK_LOW_MEM=No package PKG_CREATE_NO_CHECKS=warn
  # install built package:
  doas pkg_add -D unsigned /obfarm0.a/ports/packages/amd64/all/grok-build-0.2.112.tgz
