	@cp -f ${_RUST_CRATE_LIBDIR}/zeroize-1.8.2/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@if [ -d ${_RUST_CRATE_LIBDIR}/zeroize_derive-1.4.2/deps ]; then \
		cp -Rp ${_RUST_CRATE_LIBDIR}/zeroize_derive-1.4.2/deps/. ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true; \
	fi
	@cp -f ${_RUST_CRATE_LIBDIR}/zeroize_derive-1.4.2/lib*.rlib ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/zeroize_derive-1.4.2/lib*.so ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/zeroize_derive-1.4.2/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	# Package files are often mode 444; cargo must be able to write .d / replace units.
	@chmod -R u+w ${MODCARGO_TARGET_DIR} 2>/dev/null || true

do-build:
	@cd ${WRKDIR}/vendor/gix-hashtable-0.15.1 && \
		${SETENV} ${MAKE_ENV} \
		RUSTC_WRAPPER= \
		CARGO_BUILD_RUSTC_WRAPPER= \
		RUSTFLAGS='--cap-lints=allow' \
		CARGO_ENCODED_RUSTFLAGS='--cap-lints=allow' \
		CARGO_TARGET_DIR=${MODCARGO_TARGET_DIR} \
		CARGO_HOME=${WRKDIR}/cargo-home \
		CARGO_NET_OFFLINE=true \
		${LOCALBASE}/bin/cargo build --release --offline \
			--manifest-path Cargo.toml \
			--config ${WRKDIR}/.cargo/config.toml \
			--features sha1

do-install:
	${INSTALL_DATA_DIR} ${PREFIX}/share/modcargo-crates
	# Sanitize "+" in installed paths (pkg_create treats + as flavor).
	${INSTALL_DATA} ${FULLDISTDIR}/gix-hashtable-0.15.1.tar.gz \
		${PREFIX}/share/modcargo-crates/gix-hashtable-0.15.1.tar.gz
	${INSTALL_DATA_DIR} ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/gix-hashtable-0.15.1/deps
	# Prefer rlib; proc-macros emit .so only. [lib] name may differ from package.
	@art=""; \
	for cand in \
		${MODCARGO_TARGET_DIR}/release/deps/libgix_hashtable-*.rlib \
		${MODCARGO_TARGET_DIR}/release/libgix_hashtable.rlib \
		${MODCARGO_TARGET_DIR}/release/deps/libgix_hashtable-*.so \
		${MODCARGO_TARGET_DIR}/release/libgix_hashtable.so \
		${MODCARGO_TARGET_DIR}/release/deps/libgix_hashtable-*.rmeta \
		${MODCARGO_TARGET_DIR}/release/libgix_hashtable.rmeta; do \
		if [ -f "$$cand" ]; then art=$$cand; break; fi; \
	done; \
	if [ -z "$$art" ]; then \
		echo "ERROR: no rlib/so/rmeta for gix-hashtable (libgix_hashtable.*)" >&2; \
		ls -la ${MODCARGO_TARGET_DIR}/release/ ${MODCARGO_TARGET_DIR}/release/deps/ 2>&1 | head -40 >&2; \
		exit 1; \
	fi; \
	case "$$art" in \
	*.rlib) ext=rlib ;; \
	*.so)   ext=so ;; \
	*.rmeta) ext=rmeta ;; \
	*)      ext=rlib ;; \
	esac; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/gix-hashtable-0.15.1/libgix_hashtable.$$ext; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/gix-hashtable-0.15.1/deps/
	@rmeta=`ls ${MODCARGO_TARGET_DIR}/release/deps/libgix_hashtable-*.rmeta 2>/dev/null | head -1`; \
	if [ -n "$$rmeta" ]; then \
		${INSTALL_DATA} $$rmeta \
			${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/gix-hashtable-0.15.1/libgix_hashtable.rmeta; \
	fi
	@echo "NAME=gix-hashtable" > ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/gix-hashtable-0.15.1/crate-meta.txt
	@echo "VERSION=0.15.1" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/gix-hashtable-0.15.1/crate-meta.txt
	@echo "RUST_LIB=gix_hashtable" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/gix-hashtable-0.15.1/crate-meta.txt
	@echo "PKGNAME=rust-crate-gix_hashtable_0_15_1-0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/gix-hashtable-0.15.1/crate-meta.txt
	@echo "PROC_MACRO=0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/gix-hashtable-0.15.1/crate-meta.txt

.include <bsd.port.mk>
