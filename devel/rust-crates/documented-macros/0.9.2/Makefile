	@cp -f ${_RUST_CRATE_LIBDIR}/unicode-segmentation-1.12.0/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@if [ -d ${_RUST_CRATE_LIBDIR}/either-1.15.0/deps ]; then \
		cp -Rp ${_RUST_CRATE_LIBDIR}/either-1.15.0/deps/. ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true; \
	fi
	@cp -f ${_RUST_CRATE_LIBDIR}/either-1.15.0/lib*.rlib ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/either-1.15.0/lib*.so ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/either-1.15.0/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@if [ -d ${_RUST_CRATE_LIBDIR}/unicode-ident-1.0.24/deps ]; then \
		cp -Rp ${_RUST_CRATE_LIBDIR}/unicode-ident-1.0.24/deps/. ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true; \
	fi
	@cp -f ${_RUST_CRATE_LIBDIR}/unicode-ident-1.0.24/lib*.rlib ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/unicode-ident-1.0.24/lib*.so ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/unicode-ident-1.0.24/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@if [ -d ${_RUST_CRATE_LIBDIR}/strum_macros-0.27.2/deps ]; then \
		cp -Rp ${_RUST_CRATE_LIBDIR}/strum_macros-0.27.2/deps/. ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true; \
	fi
	@cp -f ${_RUST_CRATE_LIBDIR}/strum_macros-0.27.2/lib*.rlib ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/strum_macros-0.27.2/lib*.so ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/strum_macros-0.27.2/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@if [ -d ${_RUST_CRATE_LIBDIR}/heck-0.5.0/deps ]; then \
		cp -Rp ${_RUST_CRATE_LIBDIR}/heck-0.5.0/deps/. ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true; \
	fi
	@cp -f ${_RUST_CRATE_LIBDIR}/heck-0.5.0/lib*.rlib ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/heck-0.5.0/lib*.so ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/heck-0.5.0/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	# Package files are often mode 444; cargo must be able to write .d / replace units.
	@chmod -R u+w ${MODCARGO_TARGET_DIR} 2>/dev/null || true

do-build:
	@cd ${WRKDIR}/vendor/documented-macros-0.9.2 && \
		${SETENV} ${MAKE_ENV} \
		RUSTC_WRAPPER= \
		CARGO_BUILD_RUSTC_WRAPPER= \
		RUSTFLAGS='--cap-lints=allow' \
		CARGO_ENCODED_RUSTFLAGS='--cap-lints=allow' \
		CARGO_TARGET_DIR=${MODCARGO_TARGET_DIR} \
		CARGO_HOME=${WRKDIR}/cargo-home \
		CARGO_NET_OFFLINE=true \
		${LOCALBASE}/bin/cargo build --release --offline \
			--manifest-path Cargo.toml \
			--config ${WRKDIR}/.cargo/config.toml \
			

do-install:
	${INSTALL_DATA_DIR} ${PREFIX}/share/modcargo-crates
	# Sanitize "+" in installed paths (pkg_create treats + as flavor).
	${INSTALL_DATA} ${FULLDISTDIR}/documented-macros-0.9.2.tar.gz \
		${PREFIX}/share/modcargo-crates/documented-macros-0.9.2.tar.gz
	${INSTALL_DATA_DIR} ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/documented-macros-0.9.2/deps
	# Prefer rlib; proc-macros emit .so only. [lib] name may differ from package.
	@art=""; \
	for cand in \
		${MODCARGO_TARGET_DIR}/release/deps/libdocumented_macros-*.rlib \
		${MODCARGO_TARGET_DIR}/release/libdocumented_macros.rlib \
		${MODCARGO_TARGET_DIR}/release/deps/libdocumented_macros-*.so \
		${MODCARGO_TARGET_DIR}/release/libdocumented_macros.so \
		${MODCARGO_TARGET_DIR}/release/deps/libdocumented_macros-*.rmeta \
		${MODCARGO_TARGET_DIR}/release/libdocumented_macros.rmeta; do \
		if [ -f "$$cand" ]; then art=$$cand; break; fi; \
	done; \
	if [ -z "$$art" ]; then \
		echo "ERROR: no rlib/so/rmeta for documented-macros (libdocumented_macros.*)" >&2; \
		ls -la ${MODCARGO_TARGET_DIR}/release/ ${MODCARGO_TARGET_DIR}/release/deps/ 2>&1 | head -40 >&2; \
		exit 1; \
	fi; \
	case "$$art" in \
	*.rlib) ext=rlib ;; \
	*.so)   ext=so ;; \
	*.rmeta) ext=rmeta ;; \
	*)      ext=rlib ;; \
	esac; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/documented-macros-0.9.2/libdocumented_macros.$$ext; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/documented-macros-0.9.2/deps/
	@rmeta=`ls ${MODCARGO_TARGET_DIR}/release/deps/libdocumented_macros-*.rmeta 2>/dev/null | head -1`; \
	if [ -n "$$rmeta" ]; then \
		${INSTALL_DATA} $$rmeta \
			${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/documented-macros-0.9.2/libdocumented_macros.rmeta; \
	fi
	@echo "NAME=documented-macros" > ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/documented-macros-0.9.2/crate-meta.txt
	@echo "VERSION=0.9.2" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/documented-macros-0.9.2/crate-meta.txt
	@echo "RUST_LIB=documented_macros" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/documented-macros-0.9.2/crate-meta.txt
	@echo "PKGNAME=rust-crate-documented_macros_0_9_2-0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/documented-macros-0.9.2/crate-meta.txt
	@echo "PROC_MACRO=1" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/documented-macros-0.9.2/crate-meta.txt

.include <bsd.port.mk>
