	@cp -f ${_RUST_CRATE_LIBDIR}/miniz_oxide-0.8.9/lib*.so ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/miniz_oxide-0.8.9/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
