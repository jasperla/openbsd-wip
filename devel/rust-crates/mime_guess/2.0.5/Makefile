CONFIGURE_STYLE =	cargo
SEPARATE_BUILD =	Yes
# Crate is the project; no extra MODCARGO_CRATES (deps come from packages).
MODCARGO_CRATES =
MODCARGO_INSTALL =	No

# Match grok-build release knobs when set by the farm/env.
MAKE_ENV +=		CARGO_INCREMENTAL=0
# Do not use farm RUSTC_WRAPPER/sccache for per-crate ports: packages are the
# cache; sccache hangs have stalled whole dpb runs.
MAKE_ENV +=		RUSTC_WRAPPER=
MAKE_ENV +=		CARGO_BUILD_RUSTC_WRAPPER=
# Older crates use #![deny(warnings)]; rustc 1.97 turns many lints into hard
# errors (elided lifetimes, unexpected_cfgs). Cap all lints so we can still
# produce the rlib/.so for offline seed.
MAKE_ENV +=		RUSTFLAGS=--cap-lints=allow
MAKE_ENV +=		CARGO_ENCODED_RUSTFLAGS=--cap-lints=allow


BUILD_DEPENDS +=	rust-crate-mime_0_3_17-0:devel/rust-crates/mime/0.3.17
BUILD_DEPENDS +=	rust-crate-unicase_2_8_1-0:devel/rust-crates/unicase/2.8.1

# Direct registry deps: seed their rlibs/fingerprints before building this crate.
_RUST_CRATE_ARCH =	${MACHINE_ARCH}
_RUST_CRATE_LIBDIR =	${LOCALBASE}/lib/rust-crates/${_RUST_CRATE_ARCH}
_RUST_CRATE_SHARE =	${LOCALBASE}/share/modcargo-crates

post-extract:
	@mkdir -p ${WRKDIR}/vendor
	# This crate (+ .cargo-checksum.json for offline vendor)
	@rm -rf ${WRKDIR}/vendor/mime_guess-2.0.5
	@cp -a ${WRKSRC} ${WRKDIR}/vendor/mime_guess-2.0.5
	@${LOCALBASE}/bin/cargo-generate-vendor ${FULLDISTDIR}/mime_guess-2.0.5.tar.gz \
		${WRKDIR}/vendor/mime_guess-2.0.5
	# Dep sources from installed rust-crate-* packages (or fail if missing)
	@if [ -d ${_RUST_CRATE_SHARE}/mime-0.3.17 ]; then \
		ln -sfn ${_RUST_CRATE_SHARE}/mime-0.3.17 ${WRKDIR}/vendor/mime-0.3.17; \
	elif [ -f ${_RUST_CRATE_SHARE}/mime-0.3.17.tar.gz ]; then \
		tar xzf ${_RUST_CRATE_SHARE}/mime-0.3.17.tar.gz -C ${WRKDIR}/vendor; \
		if [ ! -d ${WRKDIR}/vendor/mime-0.3.17 ] && [ -d ${WRKDIR}/vendor/mime-0.3.17 ]; then \
			mv ${WRKDIR}/vendor/mime-0.3.17 ${WRKDIR}/vendor/mime-0.3.17; \
		fi; \
		${LOCALBASE}/bin/cargo-generate-vendor ${_RUST_CRATE_SHARE}/mime-0.3.17.tar.gz ${WRKDIR}/vendor/mime-0.3.17 2>/dev/null || true; \
	else \
		echo "missing dep mime-0.3.17" >&2; exit 1; \
	fi
	@if [ -d ${_RUST_CRATE_SHARE}/unicase-2.8.1 ]; then \
		ln -sfn ${_RUST_CRATE_SHARE}/unicase-2.8.1 ${WRKDIR}/vendor/unicase-2.8.1; \
	elif [ -f ${_RUST_CRATE_SHARE}/unicase-2.8.1.tar.gz ]; then \
		tar xzf ${_RUST_CRATE_SHARE}/unicase-2.8.1.tar.gz -C ${WRKDIR}/vendor; \
		if [ ! -d ${WRKDIR}/vendor/unicase-2.8.1 ] && [ -d ${WRKDIR}/vendor/unicase-2.8.1 ]; then \
			mv ${WRKDIR}/vendor/unicase-2.8.1 ${WRKDIR}/vendor/unicase-2.8.1; \
		fi; \
		${LOCALBASE}/bin/cargo-generate-vendor ${_RUST_CRATE_SHARE}/unicase-2.8.1.tar.gz ${WRKDIR}/vendor/unicase-2.8.1 2>/dev/null || true; \
	else \
		echo "missing dep unicase-2.8.1" >&2; exit 1; \
	fi
	# Strip optional/dev deps from EVERY vendored Cargo.toml, drop feature
	# activations that no longer exist on deps, and refresh
	# .cargo-checksum.json (editing Cargo.toml invalidates the hash).
	@python3 ${.CURDIR}/files/strip-optional-deps.py --all ${WRKDIR}/vendor

	# Pin graph so cargo does not try to resolve optional/unused deps offline.
	@cp ${.CURDIR}/files/Cargo.lock ${WRKDIR}/vendor/mime_guess-2.0.5/Cargo.lock
	@mkdir -p ${WRKDIR}/.cargo
	@echo "[build]" >${WRKDIR}/.cargo/config.toml
	@echo "rustc = '${LOCALBASE}/bin/rustc'" >>${WRKDIR}/.cargo/config.toml
	@echo "[net]" >>${WRKDIR}/.cargo/config.toml
	@echo "offline = true" >>${WRKDIR}/.cargo/config.toml
	@echo "[source.modcargo]" >>${WRKDIR}/.cargo/config.toml
	@echo "directory = '${WRKDIR}/vendor'" >>${WRKDIR}/.cargo/config.toml
	@echo "[source.crates-io]" >>${WRKDIR}/.cargo/config.toml
	@echo "replace-with = 'modcargo'" >>${WRKDIR}/.cargo/config.toml
	@ln -sf ${WRKDIR}/.cargo/config.toml ${WRKDIR}/.cargo/config

pre-build:
	@mkdir -p ${WRKDIR}/.cargo
	@echo "[build]" >${WRKDIR}/.cargo/config.toml
	@echo "rustc = '${LOCALBASE}/bin/rustc'" >>${WRKDIR}/.cargo/config.toml
	@echo "[net]" >>${WRKDIR}/.cargo/config.toml
	@echo "offline = true" >>${WRKDIR}/.cargo/config.toml
	@echo "[source.modcargo]" >>${WRKDIR}/.cargo/config.toml
	@echo "directory = '${WRKDIR}/vendor'" >>${WRKDIR}/.cargo/config.toml
	@echo "[source.crates-io]" >>${WRKDIR}/.cargo/config.toml
	@echo "replace-with = 'modcargo'" >>${WRKDIR}/.cargo/config.toml
	@ln -sf ${WRKDIR}/.cargo/config.toml ${WRKDIR}/.cargo/config
	@mkdir -p ${MODCARGO_TARGET_DIR}/release/deps
	@mkdir -p ${MODCARGO_TARGET_DIR}/release/.fingerprint
	# Seed dep cargo artifacts so cargo often skips recompiling them.
	@if [ -d ${_RUST_CRATE_LIBDIR}/mime-0.3.17/deps ]; then \
		cp -Rp ${_RUST_CRATE_LIBDIR}/mime-0.3.17/deps/. ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true; \
	fi
	@cp -f ${_RUST_CRATE_LIBDIR}/mime-0.3.17/lib*.rlib ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/mime-0.3.17/lib*.so ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/mime-0.3.17/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@if [ -d ${_RUST_CRATE_LIBDIR}/unicase-2.8.1/deps ]; then \
		cp -Rp ${_RUST_CRATE_LIBDIR}/unicase-2.8.1/deps/. ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true; \
	fi
	@cp -f ${_RUST_CRATE_LIBDIR}/unicase-2.8.1/lib*.rlib ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/unicase-2.8.1/lib*.so ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/unicase-2.8.1/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	# Package files are often mode 444; cargo must be able to write .d / replace units.
	@chmod -R u+w ${MODCARGO_TARGET_DIR} 2>/dev/null || true

do-build:
	@cd ${WRKDIR}/vendor/mime_guess-2.0.5 && \
		${SETENV} ${MAKE_ENV} \
		RUSTC_WRAPPER= \
		CARGO_BUILD_RUSTC_WRAPPER= \
		RUSTFLAGS='--cap-lints=allow' \
		CARGO_ENCODED_RUSTFLAGS='--cap-lints=allow' \
		CARGO_TARGET_DIR=${MODCARGO_TARGET_DIR} \
		CARGO_HOME=${WRKDIR}/cargo-home \
		CARGO_NET_OFFLINE=true \
		${LOCALBASE}/bin/cargo build --release --offline \
			--manifest-path Cargo.toml \
			--config ${WRKDIR}/.cargo/config.toml \
			

do-install:
	${INSTALL_DATA_DIR} ${PREFIX}/share/modcargo-crates
	# Sanitize "+" in installed paths (pkg_create treats + as flavor).
	${INSTALL_DATA} ${FULLDISTDIR}/mime_guess-2.0.5.tar.gz \
		${PREFIX}/share/modcargo-crates/mime_guess-2.0.5.tar.gz
	${INSTALL_DATA_DIR} ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/mime_guess-2.0.5/deps
	# Prefer rlib; proc-macros emit .so only. [lib] name may differ from package.
	@art=""; \
	for cand in \
		${MODCARGO_TARGET_DIR}/release/deps/libmime_guess-*.rlib \
		${MODCARGO_TARGET_DIR}/release/libmime_guess.rlib \
		${MODCARGO_TARGET_DIR}/release/deps/libmime_guess-*.so \
		${MODCARGO_TARGET_DIR}/release/libmime_guess.so \
		${MODCARGO_TARGET_DIR}/release/deps/libmime_guess-*.rmeta \
		${MODCARGO_TARGET_DIR}/release/libmime_guess.rmeta; do \
		if [ -f "$$cand" ]; then art=$$cand; break; fi; \
	done; \
	if [ -z "$$art" ]; then \
		echo "ERROR: no rlib/so/rmeta for mime_guess (libmime_guess.*)" >&2; \
		ls -la ${MODCARGO_TARGET_DIR}/release/ ${MODCARGO_TARGET_DIR}/release/deps/ 2>&1 | head -40 >&2; \
		exit 1; \
	fi; \
	case "$$art" in \
	*.rlib) ext=rlib ;; \
	*.so)   ext=so ;; \
	*.rmeta) ext=rmeta ;; \
	*)      ext=rlib ;; \
	esac; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/mime_guess-2.0.5/libmime_guess.$$ext; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/mime_guess-2.0.5/deps/
	@rmeta=`ls ${MODCARGO_TARGET_DIR}/release/deps/libmime_guess-*.rmeta 2>/dev/null | head -1`; \
	if [ -n "$$rmeta" ]; then \
		${INSTALL_DATA} $$rmeta \
			${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/mime_guess-2.0.5/libmime_guess.rmeta; \
	fi
	@echo "NAME=mime_guess" > ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/mime_guess-2.0.5/crate-meta.txt
	@echo "VERSION=2.0.5" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/mime_guess-2.0.5/crate-meta.txt
	@echo "RUST_LIB=mime_guess" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/mime_guess-2.0.5/crate-meta.txt
	@echo "PKGNAME=rust-crate-mime_guess_2_0_5-0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/mime_guess-2.0.5/crate-meta.txt
	@echo "PROC_MACRO=0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/mime_guess-2.0.5/crate-meta.txt

