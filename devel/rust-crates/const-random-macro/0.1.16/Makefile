do-build:
	@cd ${WRKDIR}/vendor/const-random-macro-0.1.16 && \
		${SETENV} ${MAKE_ENV} \
		RUSTC_WRAPPER= \
		CARGO_BUILD_RUSTC_WRAPPER= \
		RUSTFLAGS='--cap-lints=allow' \
		CARGO_ENCODED_RUSTFLAGS='--cap-lints=allow' \
		CARGO_TARGET_DIR=${MODCARGO_TARGET_DIR} \
		CARGO_HOME=${WRKDIR}/cargo-home \
		CARGO_NET_OFFLINE=true \
		${LOCALBASE}/bin/cargo build --release --offline \
			--manifest-path Cargo.toml \
			--config ${WRKDIR}/.cargo/config.toml \
			

do-install:
	${INSTALL_DATA_DIR} ${PREFIX}/share/modcargo-crates
	# Sanitize "+" in installed paths (pkg_create treats + as flavor).
	${INSTALL_DATA} ${FULLDISTDIR}/const-random-macro-0.1.16.tar.gz \
		${PREFIX}/share/modcargo-crates/const-random-macro-0.1.16.tar.gz
	${INSTALL_DATA_DIR} ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/const-random-macro-0.1.16/deps
	# Prefer rlib; proc-macros emit .so only. [lib] name may differ from package.
	@art=""; \
	for cand in \
		${MODCARGO_TARGET_DIR}/release/deps/libconst_random_macro-*.rlib \
		${MODCARGO_TARGET_DIR}/release/libconst_random_macro.rlib \
		${MODCARGO_TARGET_DIR}/release/deps/libconst_random_macro-*.so \
		${MODCARGO_TARGET_DIR}/release/libconst_random_macro.so \
		${MODCARGO_TARGET_DIR}/release/deps/libconst_random_macro-*.rmeta \
		${MODCARGO_TARGET_DIR}/release/libconst_random_macro.rmeta; do \
		if [ -f "$$cand" ]; then art=$$cand; break; fi; \
	done; \
	if [ -z "$$art" ]; then \
		echo "ERROR: no rlib/so/rmeta for const-random-macro (libconst_random_macro.*)" >&2; \
		ls -la ${MODCARGO_TARGET_DIR}/release/ ${MODCARGO_TARGET_DIR}/release/deps/ 2>&1 | head -40 >&2; \
		exit 1; \
	fi; \
	case "$$art" in \
	*.rlib) ext=rlib ;; \
	*.so)   ext=so ;; \
	*.rmeta) ext=rmeta ;; \
	*)      ext=rlib ;; \
	esac; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/const-random-macro-0.1.16/libconst_random_macro.$$ext; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/const-random-macro-0.1.16/deps/
	@rmeta=`ls ${MODCARGO_TARGET_DIR}/release/deps/libconst_random_macro-*.rmeta 2>/dev/null | head -1`; \
	if [ -n "$$rmeta" ]; then \
		${INSTALL_DATA} $$rmeta \
			${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/const-random-macro-0.1.16/libconst_random_macro.rmeta; \
	fi
	@echo "NAME=const-random-macro" > ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/const-random-macro-0.1.16/crate-meta.txt
	@echo "VERSION=0.1.16" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/const-random-macro-0.1.16/crate-meta.txt
	@echo "RUST_LIB=const_random_macro" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/const-random-macro-0.1.16/crate-meta.txt
	@echo "PKGNAME=rust-crate-const_random_macro_0_1_16-0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/const-random-macro-0.1.16/crate-meta.txt
	@echo "PROC_MACRO=1" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/const-random-macro-0.1.16/crate-meta.txt

.include <bsd.port.mk>
