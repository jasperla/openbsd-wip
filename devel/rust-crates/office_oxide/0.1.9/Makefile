do-build:
	@cd ${WRKDIR}/vendor/office_oxide-0.1.9 && \
		${SETENV} ${MAKE_ENV} \
		RUSTC_WRAPPER= \
		CARGO_BUILD_RUSTC_WRAPPER= \
		RUSTFLAGS='--cap-lints=allow' \
		CARGO_ENCODED_RUSTFLAGS='--cap-lints=allow' \
		CARGO_TARGET_DIR=${MODCARGO_TARGET_DIR} \
		CARGO_HOME=${WRKDIR}/cargo-home \
		CARGO_NET_OFFLINE=true \
		${LOCALBASE}/bin/cargo build --release --offline \
			--manifest-path Cargo.toml \
			--config ${WRKDIR}/.cargo/config.toml \
			

do-install:
	${INSTALL_DATA_DIR} ${PREFIX}/share/modcargo-crates
	# Sanitize "+" in installed paths (pkg_create treats + as flavor).
	${INSTALL_DATA} ${FULLDISTDIR}/office_oxide-0.1.9.tar.gz \
		${PREFIX}/share/modcargo-crates/office_oxide-0.1.9.tar.gz
	${INSTALL_DATA_DIR} ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/office_oxide-0.1.9/deps
	# Prefer rlib; proc-macros emit .so only. [lib] name may differ from package.
	@art=""; \
	for cand in \
		${MODCARGO_TARGET_DIR}/release/deps/liboffice_oxide-*.rlib \
		${MODCARGO_TARGET_DIR}/release/liboffice_oxide.rlib \
		${MODCARGO_TARGET_DIR}/release/deps/liboffice_oxide-*.so \
		${MODCARGO_TARGET_DIR}/release/liboffice_oxide.so \
		${MODCARGO_TARGET_DIR}/release/deps/liboffice_oxide-*.rmeta \
		${MODCARGO_TARGET_DIR}/release/liboffice_oxide.rmeta; do \
		if [ -f "$$cand" ]; then art=$$cand; break; fi; \
	done; \
	if [ -z "$$art" ]; then \
		for cand in \
			${MODCARGO_TARGET_DIR}/release/lib*.rlib \
			${MODCARGO_TARGET_DIR}/release/lib*.so; do \
			if [ -f "$$cand" ]; then \
				echo "ERROR: office_oxide built $$cand but port rust_lib=office_oxide (Cargo.toml [lib] name?)" >&2; \
				echo "ERROR: regen with gen-rust-crate-ports.py (do not hand-edit PLIST)" >&2; \
				exit 1; \
			fi; \
		done; \
		echo "ERROR: no rlib/so/rmeta for office_oxide (liboffice_oxide.*)" >&2; \
		ls -la ${MODCARGO_TARGET_DIR}/release/ ${MODCARGO_TARGET_DIR}/release/deps/ 2>&1 | head -40 >&2; \
		exit 1; \
	fi; \
	case "$$art" in \
	*.rlib) ext=rlib ;; \
	*.so)   ext=so ;; \
	*.rmeta) ext=rmeta ;; \
	*)      ext=rlib ;; \
	esac; \
	want_ext=rlib; \
	if [ "0" = "1" ]; then want_ext=so; fi; \
	if [ "$$ext" != "$$want_ext" ]; then \
		echo "ERROR: office_oxide produced .$$ext but PROC_MACRO=0 expects .$$want_ext" >&2; \
		echo "ERROR: regen with gen-rust-crate-ports.py (do not hand-edit PLIST)" >&2; \
		ls -la ${MODCARGO_TARGET_DIR}/release/ ${MODCARGO_TARGET_DIR}/release/deps/ 2>&1 | head -40 >&2; \
		exit 1; \
	fi; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/office_oxide-0.1.9/liboffice_oxide.$$ext; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/office_oxide-0.1.9/deps/
	@rmeta=`ls ${MODCARGO_TARGET_DIR}/release/deps/liboffice_oxide-*.rmeta 2>/dev/null | head -1`; \
	if [ -n "$$rmeta" ]; then \
		${INSTALL_DATA} $$rmeta \
			${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/office_oxide-0.1.9/liboffice_oxide.rmeta; \
	fi
	@echo "NAME=office_oxide" > ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/office_oxide-0.1.9/crate-meta.txt
	@echo "VERSION=0.1.9" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/office_oxide-0.1.9/crate-meta.txt
	@echo "RUST_LIB=office_oxide" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/office_oxide-0.1.9/crate-meta.txt
	@echo "PKGNAME=rust-crate-office_oxide_0_1_9-0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/office_oxide-0.1.9/crate-meta.txt
	@echo "PROC_MACRO=0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/office_oxide-0.1.9/crate-meta.txt

.include <bsd.port.mk>
