do-build:
	@cd ${WRKDIR}/vendor/aws-smithy-checksums-0.63.13 && \
		${SETENV} ${MAKE_ENV} \
		RUSTC_WRAPPER= \
		CARGO_BUILD_RUSTC_WRAPPER= \
		RUSTFLAGS='--cap-lints=allow' \
		CARGO_ENCODED_RUSTFLAGS='--cap-lints=allow' \
		CARGO_TARGET_DIR=${MODCARGO_TARGET_DIR} \
		CARGO_HOME=${WRKDIR}/cargo-home \
		CARGO_NET_OFFLINE=true \
		${LOCALBASE}/bin/cargo build --release --offline \
			--manifest-path Cargo.toml \
			--config ${WRKDIR}/.cargo/config.toml \
			

do-install:
	${INSTALL_DATA_DIR} ${PREFIX}/share/modcargo-crates
	# Sanitize "+" in installed paths (pkg_create treats + as flavor).
	${INSTALL_DATA} ${FULLDISTDIR}/aws-smithy-checksums-0.63.13.tar.gz \
		${PREFIX}/share/modcargo-crates/aws-smithy-checksums-0.63.13.tar.gz
	${INSTALL_DATA_DIR} ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/aws-smithy-checksums-0.63.13/deps
	# Prefer rlib; proc-macros emit .so only. [lib] name may differ from package.
	@art=""; \
	for cand in \
		${MODCARGO_TARGET_DIR}/release/deps/libaws_smithy_checksums-*.rlib \
		${MODCARGO_TARGET_DIR}/release/libaws_smithy_checksums.rlib \
		${MODCARGO_TARGET_DIR}/release/deps/libaws_smithy_checksums-*.so \
		${MODCARGO_TARGET_DIR}/release/libaws_smithy_checksums.so \
		${MODCARGO_TARGET_DIR}/release/deps/libaws_smithy_checksums-*.rmeta \
		${MODCARGO_TARGET_DIR}/release/libaws_smithy_checksums.rmeta; do \
		if [ -f "$$cand" ]; then art=$$cand; break; fi; \
	done; \
	if [ -z "$$art" ]; then \
		for cand in \
			${MODCARGO_TARGET_DIR}/release/lib*.rlib \
			${MODCARGO_TARGET_DIR}/release/lib*.so; do \
			if [ -f "$$cand" ]; then \
				echo "ERROR: aws-smithy-checksums built $$cand but port rust_lib=aws_smithy_checksums (Cargo.toml [lib] name?)" >&2; \
				echo "ERROR: regen with gen-rust-crate-ports.py (do not hand-edit PLIST)" >&2; \
				exit 1; \
			fi; \
		done; \
		echo "ERROR: no rlib/so/rmeta for aws-smithy-checksums (libaws_smithy_checksums.*)" >&2; \
		ls -la ${MODCARGO_TARGET_DIR}/release/ ${MODCARGO_TARGET_DIR}/release/deps/ 2>&1 | head -40 >&2; \
		exit 1; \
	fi; \
	case "$$art" in \
	*.rlib) ext=rlib ;; \
	*.so)   ext=so ;; \
	*.rmeta) ext=rmeta ;; \
	*)      ext=rlib ;; \
	esac; \
	want_ext=rlib; \
	if [ "0" = "1" ]; then want_ext=so; fi; \
	if [ "$$ext" != "$$want_ext" ]; then \
		echo "ERROR: aws-smithy-checksums produced .$$ext but PROC_MACRO=0 expects .$$want_ext" >&2; \
		echo "ERROR: regen with gen-rust-crate-ports.py (do not hand-edit PLIST)" >&2; \
		ls -la ${MODCARGO_TARGET_DIR}/release/ ${MODCARGO_TARGET_DIR}/release/deps/ 2>&1 | head -40 >&2; \
		exit 1; \
	fi; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/aws-smithy-checksums-0.63.13/libaws_smithy_checksums.$$ext; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/aws-smithy-checksums-0.63.13/deps/
	@rmeta=`ls ${MODCARGO_TARGET_DIR}/release/deps/libaws_smithy_checksums-*.rmeta 2>/dev/null | head -1`; \
	if [ -n "$$rmeta" ]; then \
		${INSTALL_DATA} $$rmeta \
			${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/aws-smithy-checksums-0.63.13/libaws_smithy_checksums.rmeta; \
	fi
	@echo "NAME=aws-smithy-checksums" > ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/aws-smithy-checksums-0.63.13/crate-meta.txt
	@echo "VERSION=0.63.13" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/aws-smithy-checksums-0.63.13/crate-meta.txt
	@echo "RUST_LIB=aws_smithy_checksums" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/aws-smithy-checksums-0.63.13/crate-meta.txt
	@echo "PKGNAME=rust-crate-aws_smithy_checksums_0_63_13-0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/aws-smithy-checksums-0.63.13/crate-meta.txt
	@echo "PROC_MACRO=0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/aws-smithy-checksums-0.63.13/crate-meta.txt

.include <bsd.port.mk>
