	@cp -f ${_RUST_CRATE_LIBDIR}/is_terminal_polyfill-1.70.2/lib*.rlib ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/is_terminal_polyfill-1.70.2/lib*.so ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/is_terminal_polyfill-1.70.2/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@if [ -d ${_RUST_CRATE_LIBDIR}/utf8parse-0.2.2/deps ]; then \
		cp -Rp ${_RUST_CRATE_LIBDIR}/utf8parse-0.2.2/deps/. ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true; \
	fi
	@cp -f ${_RUST_CRATE_LIBDIR}/utf8parse-0.2.2/lib*.rlib ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/utf8parse-0.2.2/lib*.so ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/utf8parse-0.2.2/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@if [ -d ${_RUST_CRATE_LIBDIR}/once_cell_polyfill-1.70.2/deps ]; then \
		cp -Rp ${_RUST_CRATE_LIBDIR}/once_cell_polyfill-1.70.2/deps/. ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true; \
	fi
	@cp -f ${_RUST_CRATE_LIBDIR}/once_cell_polyfill-1.70.2/lib*.rlib ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/once_cell_polyfill-1.70.2/lib*.so ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/once_cell_polyfill-1.70.2/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	# Package files are often mode 444; cargo must be able to write .d / replace units.
	@chmod -R u+w ${MODCARGO_TARGET_DIR} 2>/dev/null || true

do-build:
	@cd ${WRKDIR}/vendor/clap_builder-4.5.53 && \
		${SETENV} ${MAKE_ENV} \
		RUSTC_WRAPPER= \
		CARGO_BUILD_RUSTC_WRAPPER= \
		RUSTFLAGS='--cap-lints=allow' \
		CARGO_ENCODED_RUSTFLAGS='--cap-lints=allow' \
		CARGO_TARGET_DIR=${MODCARGO_TARGET_DIR} \
		CARGO_HOME=${WRKDIR}/cargo-home \
		CARGO_NET_OFFLINE=true \
		${LOCALBASE}/bin/cargo build --release --offline \
			--manifest-path Cargo.toml \
			--config ${WRKDIR}/.cargo/config.toml \
			

do-install:
	${INSTALL_DATA_DIR} ${PREFIX}/share/modcargo-crates
	# Sanitize "+" in installed paths (pkg_create treats + as flavor).
	${INSTALL_DATA} ${FULLDISTDIR}/clap_builder-4.5.53.tar.gz \
		${PREFIX}/share/modcargo-crates/clap_builder-4.5.53.tar.gz
	${INSTALL_DATA_DIR} ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/clap_builder-4.5.53/deps
	# Prefer rlib; proc-macros emit .so only. [lib] name may differ from package.
	@art=""; \
	for cand in \
		${MODCARGO_TARGET_DIR}/release/deps/libclap_builder-*.rlib \
		${MODCARGO_TARGET_DIR}/release/libclap_builder.rlib \
		${MODCARGO_TARGET_DIR}/release/deps/libclap_builder-*.so \
		${MODCARGO_TARGET_DIR}/release/libclap_builder.so \
		${MODCARGO_TARGET_DIR}/release/deps/libclap_builder-*.rmeta \
		${MODCARGO_TARGET_DIR}/release/libclap_builder.rmeta; do \
		if [ -f "$$cand" ]; then art=$$cand; break; fi; \
	done; \
	if [ -z "$$art" ]; then \
		echo "ERROR: no rlib/so/rmeta for clap_builder (libclap_builder.*)" >&2; \
		ls -la ${MODCARGO_TARGET_DIR}/release/ ${MODCARGO_TARGET_DIR}/release/deps/ 2>&1 | head -40 >&2; \
		exit 1; \
	fi; \
	case "$$art" in \
	*.rlib) ext=rlib ;; \
	*.so)   ext=so ;; \
	*.rmeta) ext=rmeta ;; \
	*)      ext=rlib ;; \
	esac; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/clap_builder-4.5.53/libclap_builder.$$ext; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/clap_builder-4.5.53/deps/
	@rmeta=`ls ${MODCARGO_TARGET_DIR}/release/deps/libclap_builder-*.rmeta 2>/dev/null | head -1`; \
	if [ -n "$$rmeta" ]; then \
		${INSTALL_DATA} $$rmeta \
			${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/clap_builder-4.5.53/libclap_builder.rmeta; \
	fi
	@echo "NAME=clap_builder" > ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/clap_builder-4.5.53/crate-meta.txt
	@echo "VERSION=4.5.53" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/clap_builder-4.5.53/crate-meta.txt
	@echo "RUST_LIB=clap_builder" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/clap_builder-4.5.53/crate-meta.txt
	@echo "PKGNAME=rust-crate-clap_builder_4_5_53-0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/clap_builder-4.5.53/crate-meta.txt
	@echo "PROC_MACRO=0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/clap_builder-4.5.53/crate-meta.txt

.include <bsd.port.mk>
