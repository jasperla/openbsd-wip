pre-build:
	@mkdir -p ${WRKDIR}/.cargo
	@echo "[build]" >${WRKDIR}/.cargo/config.toml
	@echo "rustc = '${LOCALBASE}/bin/rustc'" >>${WRKDIR}/.cargo/config.toml
	@echo "[net]" >>${WRKDIR}/.cargo/config.toml
	@echo "offline = true" >>${WRKDIR}/.cargo/config.toml
	@echo "[source.modcargo]" >>${WRKDIR}/.cargo/config.toml
	@echo "directory = '${WRKDIR}/vendor'" >>${WRKDIR}/.cargo/config.toml
	@echo "[source.crates-io]" >>${WRKDIR}/.cargo/config.toml
	@echo "replace-with = 'modcargo'" >>${WRKDIR}/.cargo/config.toml
	@ln -sf ${WRKDIR}/.cargo/config.toml ${WRKDIR}/.cargo/config
	@mkdir -p ${MODCARGO_TARGET_DIR}/release/deps
	@mkdir -p ${MODCARGO_TARGET_DIR}/release/.fingerprint
	# Seed dep cargo artifacts so cargo often skips recompiling them.
	@if [ -d ${_RUST_CRATE_LIBDIR}/gix-commitgraph-0.37.1/deps ]; then \
		cp -Rp ${_RUST_CRATE_LIBDIR}/gix-commitgraph-0.37.1/deps/. ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true; \
	fi
	@cp -f ${_RUST_CRATE_LIBDIR}/gix-commitgraph-0.37.1/lib*.rlib ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/gix-commitgraph-0.37.1/lib*.so ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/gix-commitgraph-0.37.1/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@if [ -d ${_RUST_CRATE_LIBDIR}/gix-date-0.15.5/deps ]; then \
		cp -Rp ${_RUST_CRATE_LIBDIR}/gix-date-0.15.5/deps/. ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true; \
	fi
	@cp -f ${_RUST_CRATE_LIBDIR}/gix-date-0.15.5/lib*.rlib ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/gix-date-0.15.5/lib*.so ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/gix-date-0.15.5/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@if [ -d ${_RUST_CRATE_LIBDIR}/gix-diff-0.63.0/deps ]; then \
		cp -Rp ${_RUST_CRATE_LIBDIR}/gix-diff-0.63.0/deps/. ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true; \
	fi
	@cp -f ${_RUST_CRATE_LIBDIR}/gix-diff-0.63.0/lib*.rlib ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/gix-diff-0.63.0/lib*.so ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
