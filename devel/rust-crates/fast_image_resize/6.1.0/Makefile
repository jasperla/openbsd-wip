	@cp -f ${_RUST_CRATE_LIBDIR}/thiserror-impl-2.0.18/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@if [ -d ${_RUST_CRATE_LIBDIR}/proc-macro2-1.0.106/deps ]; then \
		cp -Rp ${_RUST_CRATE_LIBDIR}/proc-macro2-1.0.106/deps/. ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true; \
	fi
	@cp -f ${_RUST_CRATE_LIBDIR}/proc-macro2-1.0.106/lib*.rlib ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/proc-macro2-1.0.106/lib*.so ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/proc-macro2-1.0.106/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@if [ -d ${_RUST_CRATE_LIBDIR}/quote-1.0.45/deps ]; then \
		cp -Rp ${_RUST_CRATE_LIBDIR}/quote-1.0.45/deps/. ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true; \
	fi
	@cp -f ${_RUST_CRATE_LIBDIR}/quote-1.0.45/lib*.rlib ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/quote-1.0.45/lib*.so ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/quote-1.0.45/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@if [ -d ${_RUST_CRATE_LIBDIR}/syn-2.0.117/deps ]; then \
		cp -Rp ${_RUST_CRATE_LIBDIR}/syn-2.0.117/deps/. ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true; \
	fi
	@cp -f ${_RUST_CRATE_LIBDIR}/syn-2.0.117/lib*.rlib ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/syn-2.0.117/lib*.so ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/syn-2.0.117/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@if [ -d ${_RUST_CRATE_LIBDIR}/unicode-ident-1.0.24/deps ]; then \
		cp -Rp ${_RUST_CRATE_LIBDIR}/unicode-ident-1.0.24/deps/. ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true; \
	fi
	@cp -f ${_RUST_CRATE_LIBDIR}/unicode-ident-1.0.24/lib*.rlib ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/unicode-ident-1.0.24/lib*.so ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/unicode-ident-1.0.24/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	# Package files are often mode 444; cargo must be able to write .d / replace units.
	@chmod -R u+w ${MODCARGO_TARGET_DIR} 2>/dev/null || true

do-build:
	@cd ${WRKDIR}/vendor/fast_image_resize-6.1.0 && \
		${SETENV} ${MAKE_ENV} \
		RUSTC_WRAPPER= \
		CARGO_BUILD_RUSTC_WRAPPER= \
		RUSTFLAGS='--cap-lints=allow' \
		CARGO_ENCODED_RUSTFLAGS='--cap-lints=allow' \
		CARGO_TARGET_DIR=${MODCARGO_TARGET_DIR} \
		CARGO_HOME=${WRKDIR}/cargo-home \
		CARGO_NET_OFFLINE=true \
		${LOCALBASE}/bin/cargo build --release --offline \
			--manifest-path Cargo.toml \
			--config ${WRKDIR}/.cargo/config.toml \
			

do-install:
	${INSTALL_DATA_DIR} ${PREFIX}/share/modcargo-crates
	# Sanitize "+" in installed paths (pkg_create treats + as flavor).
	${INSTALL_DATA} ${FULLDISTDIR}/fast_image_resize-6.1.0.tar.gz \
		${PREFIX}/share/modcargo-crates/fast_image_resize-6.1.0.tar.gz
	${INSTALL_DATA_DIR} ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/fast_image_resize-6.1.0/deps
	# Prefer rlib; proc-macros emit .so only. [lib] name may differ from package.
	@art=""; \
	for cand in \
		${MODCARGO_TARGET_DIR}/release/deps/libfast_image_resize-*.rlib \
		${MODCARGO_TARGET_DIR}/release/libfast_image_resize.rlib \
		${MODCARGO_TARGET_DIR}/release/deps/libfast_image_resize-*.so \
		${MODCARGO_TARGET_DIR}/release/libfast_image_resize.so \
		${MODCARGO_TARGET_DIR}/release/deps/libfast_image_resize-*.rmeta \
		${MODCARGO_TARGET_DIR}/release/libfast_image_resize.rmeta; do \
		if [ -f "$$cand" ]; then art=$$cand; break; fi; \
	done; \
	if [ -z "$$art" ]; then \
		echo "ERROR: no rlib/so/rmeta for fast_image_resize (libfast_image_resize.*)" >&2; \
		ls -la ${MODCARGO_TARGET_DIR}/release/ ${MODCARGO_TARGET_DIR}/release/deps/ 2>&1 | head -40 >&2; \
		exit 1; \
	fi; \
	case "$$art" in \
	*.rlib) ext=rlib ;; \
	*.so)   ext=so ;; \
	*.rmeta) ext=rmeta ;; \
	*)      ext=rlib ;; \
	esac; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/fast_image_resize-6.1.0/libfast_image_resize.$$ext; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/fast_image_resize-6.1.0/deps/
	@rmeta=`ls ${MODCARGO_TARGET_DIR}/release/deps/libfast_image_resize-*.rmeta 2>/dev/null | head -1`; \
	if [ -n "$$rmeta" ]; then \
		${INSTALL_DATA} $$rmeta \
			${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/fast_image_resize-6.1.0/libfast_image_resize.rmeta; \
	fi
	@echo "NAME=fast_image_resize" > ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/fast_image_resize-6.1.0/crate-meta.txt
	@echo "VERSION=6.1.0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/fast_image_resize-6.1.0/crate-meta.txt
	@echo "RUST_LIB=fast_image_resize" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/fast_image_resize-6.1.0/crate-meta.txt
	@echo "PKGNAME=rust-crate-fast_image_resize_6_1_0-0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/fast_image_resize-6.1.0/crate-meta.txt
	@echo "PROC_MACRO=0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/fast_image_resize-6.1.0/crate-meta.txt

.include <bsd.port.mk>
