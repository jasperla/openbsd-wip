		tar xzf ${_RUST_CRATE_SHARE}/syn-2.0.117.tar.gz -C ${WRKDIR}/vendor; \
		if [ ! -d ${WRKDIR}/vendor/syn-2.0.117 ] && [ -d ${WRKDIR}/vendor/syn-2.0.117 ]; then \
			mv ${WRKDIR}/vendor/syn-2.0.117 ${WRKDIR}/vendor/syn-2.0.117; \
		fi; \
		${LOCALBASE}/bin/cargo-generate-vendor ${_RUST_CRATE_SHARE}/syn-2.0.117.tar.gz ${WRKDIR}/vendor/syn-2.0.117 2>/dev/null || true; \
	else \
		echo "missing dep syn-2.0.117" >&2; exit 1; \
	fi
	@if [ -d ${_RUST_CRATE_SHARE}/unicode-ident-1.0.24 ]; then \
		ln -sfn ${_RUST_CRATE_SHARE}/unicode-ident-1.0.24 ${WRKDIR}/vendor/unicode-ident-1.0.24; \
	elif [ -f ${_RUST_CRATE_SHARE}/unicode-ident-1.0.24.tar.gz ]; then \
		tar xzf ${_RUST_CRATE_SHARE}/unicode-ident-1.0.24.tar.gz -C ${WRKDIR}/vendor; \
		if [ ! -d ${WRKDIR}/vendor/unicode-ident-1.0.24 ] && [ -d ${WRKDIR}/vendor/unicode-ident-1.0.24 ]; then \
			mv ${WRKDIR}/vendor/unicode-ident-1.0.24 ${WRKDIR}/vendor/unicode-ident-1.0.24; \
		fi; \
		${LOCALBASE}/bin/cargo-generate-vendor ${_RUST_CRATE_SHARE}/unicode-ident-1.0.24.tar.gz ${WRKDIR}/vendor/unicode-ident-1.0.24 2>/dev/null || true; \
	else \
		echo "missing dep unicode-ident-1.0.24" >&2; exit 1; \
	fi
	# Strip optional/dev deps from EVERY vendored Cargo.toml, drop feature
	# activations that no longer exist on deps, and refresh
	# .cargo-checksum.json (editing Cargo.toml invalidates the hash).
	@python3 ${.CURDIR}/files/strip-optional-deps.py --all ${WRKDIR}/vendor

	# Pin graph so cargo does not try to resolve optional/unused deps offline.
	@cp ${.CURDIR}/files/Cargo.lock ${WRKDIR}/vendor/rustybuzz-0.20.1/Cargo.lock
	@mkdir -p ${WRKDIR}/.cargo
	@echo "[build]" >${WRKDIR}/.cargo/config.toml
	@echo "rustc = '${LOCALBASE}/bin/rustc'" >>${WRKDIR}/.cargo/config.toml
	@echo "[net]" >>${WRKDIR}/.cargo/config.toml
	@echo "offline = true" >>${WRKDIR}/.cargo/config.toml
	@echo "[source.modcargo]" >>${WRKDIR}/.cargo/config.toml
	@echo "directory = '${WRKDIR}/vendor'" >>${WRKDIR}/.cargo/config.toml
	@echo "[source.crates-io]" >>${WRKDIR}/.cargo/config.toml
	@echo "replace-with = 'modcargo'" >>${WRKDIR}/.cargo/config.toml
	@ln -sf ${WRKDIR}/.cargo/config.toml ${WRKDIR}/.cargo/config

