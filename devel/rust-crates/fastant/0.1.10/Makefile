# Required when DIST_SUBDIR is set (cargo.port.mk).
MODCARGO_DIST_SUBDIR =	cargo
# crates.io serves fastant/0.1.10/download (403 on …/name-ver.tar.gz).
SITES =			https://crates.io/api/v1/crates/
DISTFILES =		fastant-0.1.10.tar.gz{fastant/0.1.10/download}
WRKDIST =		${WRKDIR}/fastant-0.1.10

MODULES =		devel/cargo
CONFIGURE_STYLE =	cargo
SEPARATE_BUILD =	Yes
# Crate is the project; no extra MODCARGO_CRATES (deps come from packages).
MODCARGO_CRATES =
MODCARGO_INSTALL =	No

# Match grok-build release knobs when set by the farm/env.
MAKE_ENV +=		CARGO_INCREMENTAL=0
# Do not use farm RUSTC_WRAPPER/sccache for per-crate ports: packages are the
# cache; sccache hangs have stalled whole dpb runs.
MAKE_ENV +=		RUSTC_WRAPPER=
MAKE_ENV +=		CARGO_BUILD_RUSTC_WRAPPER=
# Older crates use #![deny(warnings)]; rustc 1.97 turns many lints into hard
# errors (elided lifetimes, unexpected_cfgs). Cap all lints so we can still
# produce the rlib/.so for offline seed.
MAKE_ENV +=		RUSTFLAGS=--cap-lints=allow
MAKE_ENV +=		CARGO_ENCODED_RUSTFLAGS=--cap-lints=allow


BUILD_DEPENDS +=	rust-crate-small_ctor_0_1_2-0:devel/rust-crates/small_ctor/0.1.2
BUILD_DEPENDS +=	rust-crate-web_time_1_1_0-0:devel/rust-crates/web-time/1.1.0

# Direct registry deps: seed their rlibs/fingerprints before building this crate.
_RUST_CRATE_ARCH =	${MACHINE_ARCH}
_RUST_CRATE_LIBDIR =	${LOCALBASE}/lib/rust-crates/${_RUST_CRATE_ARCH}
_RUST_CRATE_SHARE =	${LOCALBASE}/share/modcargo-crates

post-extract:
	@mkdir -p ${WRKDIR}/vendor
	# This crate (+ .cargo-checksum.json for offline vendor)
	@rm -rf ${WRKDIR}/vendor/fastant-0.1.10
	@cp -a ${WRKSRC} ${WRKDIR}/vendor/fastant-0.1.10
	@${LOCALBASE}/bin/cargo-generate-vendor ${FULLDISTDIR}/fastant-0.1.10.tar.gz \
		${WRKDIR}/vendor/fastant-0.1.10
	# Dep sources from installed rust-crate-* packages (or fail if missing)
	@if [ -d ${_RUST_CRATE_SHARE}/small_ctor-0.1.2 ]; then \
		ln -sfn ${_RUST_CRATE_SHARE}/small_ctor-0.1.2 ${WRKDIR}/vendor/small_ctor-0.1.2; \
	elif [ -f ${_RUST_CRATE_SHARE}/small_ctor-0.1.2.tar.gz ]; then \
		tar xzf ${_RUST_CRATE_SHARE}/small_ctor-0.1.2.tar.gz -C ${WRKDIR}/vendor; \
		if [ ! -d ${WRKDIR}/vendor/small_ctor-0.1.2 ] && [ -d ${WRKDIR}/vendor/small_ctor-0.1.2 ]; then \
			mv ${WRKDIR}/vendor/small_ctor-0.1.2 ${WRKDIR}/vendor/small_ctor-0.1.2; \
		fi; \
		${LOCALBASE}/bin/cargo-generate-vendor ${_RUST_CRATE_SHARE}/small_ctor-0.1.2.tar.gz ${WRKDIR}/vendor/small_ctor-0.1.2 2>/dev/null || true; \
	else \
		echo "missing dep small_ctor-0.1.2" >&2; exit 1; \
	fi
	@if [ -d ${_RUST_CRATE_SHARE}/web-time-1.1.0 ]; then \
		ln -sfn ${_RUST_CRATE_SHARE}/web-time-1.1.0 ${WRKDIR}/vendor/web-time-1.1.0; \
	elif [ -f ${_RUST_CRATE_SHARE}/web-time-1.1.0.tar.gz ]; then \
		tar xzf ${_RUST_CRATE_SHARE}/web-time-1.1.0.tar.gz -C ${WRKDIR}/vendor; \
		if [ ! -d ${WRKDIR}/vendor/web-time-1.1.0 ] && [ -d ${WRKDIR}/vendor/web-time-1.1.0 ]; then \
			mv ${WRKDIR}/vendor/web-time-1.1.0 ${WRKDIR}/vendor/web-time-1.1.0; \
		fi; \
		${LOCALBASE}/bin/cargo-generate-vendor ${_RUST_CRATE_SHARE}/web-time-1.1.0.tar.gz ${WRKDIR}/vendor/web-time-1.1.0 2>/dev/null || true; \
	else \
		echo "missing dep web-time-1.1.0" >&2; exit 1; \
	fi
	# Strip optional/dev deps from EVERY vendored Cargo.toml, drop feature
	# activations that no longer exist on deps, and refresh
	# .cargo-checksum.json (editing Cargo.toml invalidates the hash).
	@python3 ${.CURDIR}/files/strip-optional-deps.py --all ${WRKDIR}/vendor

	# Pin graph so cargo does not try to resolve optional/unused deps offline.
	@cp ${.CURDIR}/files/Cargo.lock ${WRKDIR}/vendor/fastant-0.1.10/Cargo.lock
	@mkdir -p ${WRKDIR}/.cargo
	@echo "[build]" >${WRKDIR}/.cargo/config.toml
	@echo "rustc = '${LOCALBASE}/bin/rustc'" >>${WRKDIR}/.cargo/config.toml
	@echo "[net]" >>${WRKDIR}/.cargo/config.toml
	@echo "offline = true" >>${WRKDIR}/.cargo/config.toml
	@echo "[source.modcargo]" >>${WRKDIR}/.cargo/config.toml
	@echo "directory = '${WRKDIR}/vendor'" >>${WRKDIR}/.cargo/config.toml
	@echo "[source.crates-io]" >>${WRKDIR}/.cargo/config.toml
	@echo "replace-with = 'modcargo'" >>${WRKDIR}/.cargo/config.toml
	@ln -sf ${WRKDIR}/.cargo/config.toml ${WRKDIR}/.cargo/config

pre-build:
	@mkdir -p ${WRKDIR}/.cargo
	@echo "[build]" >${WRKDIR}/.cargo/config.toml
	@echo "rustc = '${LOCALBASE}/bin/rustc'" >>${WRKDIR}/.cargo/config.toml
	@echo "[net]" >>${WRKDIR}/.cargo/config.toml
	@echo "offline = true" >>${WRKDIR}/.cargo/config.toml
	@echo "[source.modcargo]" >>${WRKDIR}/.cargo/config.toml
	@echo "directory = '${WRKDIR}/vendor'" >>${WRKDIR}/.cargo/config.toml
	@echo "[source.crates-io]" >>${WRKDIR}/.cargo/config.toml
	@echo "replace-with = 'modcargo'" >>${WRKDIR}/.cargo/config.toml
	@ln -sf ${WRKDIR}/.cargo/config.toml ${WRKDIR}/.cargo/config
	@mkdir -p ${MODCARGO_TARGET_DIR}/release/deps
	@mkdir -p ${MODCARGO_TARGET_DIR}/release/.fingerprint
	# Seed dep cargo artifacts so cargo often skips recompiling them.
	@if [ -d ${_RUST_CRATE_LIBDIR}/small_ctor-0.1.2/deps ]; then \
		cp -Rp ${_RUST_CRATE_LIBDIR}/small_ctor-0.1.2/deps/. ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true; \
	fi
	@cp -f ${_RUST_CRATE_LIBDIR}/small_ctor-0.1.2/lib*.rlib ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/small_ctor-0.1.2/lib*.so ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/small_ctor-0.1.2/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@if [ -d ${_RUST_CRATE_LIBDIR}/web-time-1.1.0/deps ]; then \
		cp -Rp ${_RUST_CRATE_LIBDIR}/web-time-1.1.0/deps/. ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true; \
	fi
	@cp -f ${_RUST_CRATE_LIBDIR}/web-time-1.1.0/lib*.rlib ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/web-time-1.1.0/lib*.so ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/web-time-1.1.0/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	# Package files are often mode 444; cargo must be able to write .d / replace units.
	@chmod -R u+w ${MODCARGO_TARGET_DIR} 2>/dev/null || true

do-build:
	@cd ${WRKDIR}/vendor/fastant-0.1.10 && \
		${SETENV} ${MAKE_ENV} \
		RUSTC_WRAPPER= \
		CARGO_BUILD_RUSTC_WRAPPER= \
		RUSTFLAGS='--cap-lints=allow' \
		CARGO_ENCODED_RUSTFLAGS='--cap-lints=allow' \
		CARGO_TARGET_DIR=${MODCARGO_TARGET_DIR} \
		CARGO_HOME=${WRKDIR}/cargo-home \
		CARGO_NET_OFFLINE=true \
		${LOCALBASE}/bin/cargo build --release --offline \
			--manifest-path Cargo.toml \
			--config ${WRKDIR}/.cargo/config.toml \
			

do-install:
	${INSTALL_DATA_DIR} ${PREFIX}/share/modcargo-crates
	# Sanitize "+" in installed paths (pkg_create treats + as flavor).
	${INSTALL_DATA} ${FULLDISTDIR}/fastant-0.1.10.tar.gz \
		${PREFIX}/share/modcargo-crates/fastant-0.1.10.tar.gz
	${INSTALL_DATA_DIR} ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/fastant-0.1.10/deps
	# Prefer rlib; proc-macros emit .so only. [lib] name may differ from package.
	@art=""; \
	for cand in \
		${MODCARGO_TARGET_DIR}/release/deps/libfastant-*.rlib \
		${MODCARGO_TARGET_DIR}/release/libfastant.rlib \
		${MODCARGO_TARGET_DIR}/release/deps/libfastant-*.so \
		${MODCARGO_TARGET_DIR}/release/libfastant.so \
		${MODCARGO_TARGET_DIR}/release/deps/libfastant-*.rmeta \
		${MODCARGO_TARGET_DIR}/release/libfastant.rmeta; do \
		if [ -f "$$cand" ]; then art=$$cand; break; fi; \
	done; \
	if [ -z "$$art" ]; then \
		echo "ERROR: no rlib/so/rmeta for fastant (libfastant.*)" >&2; \
		ls -la ${MODCARGO_TARGET_DIR}/release/ ${MODCARGO_TARGET_DIR}/release/deps/ 2>&1 | head -40 >&2; \
		exit 1; \
	fi; \
	case "$$art" in \
	*.rlib) ext=rlib ;; \
	*.so)   ext=so ;; \
	*.rmeta) ext=rmeta ;; \
	*)      ext=rlib ;; \
	esac; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/fastant-0.1.10/libfastant.$$ext; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/fastant-0.1.10/deps/
	@rmeta=`ls ${MODCARGO_TARGET_DIR}/release/deps/libfastant-*.rmeta 2>/dev/null | head -1`; \
	if [ -n "$$rmeta" ]; then \
		${INSTALL_DATA} $$rmeta \
			${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/fastant-0.1.10/libfastant.rmeta; \
	fi
	@echo "NAME=fastant" > ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/fastant-0.1.10/crate-meta.txt
	@echo "VERSION=0.1.10" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/fastant-0.1.10/crate-meta.txt
	@echo "RUST_LIB=fastant" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/fastant-0.1.10/crate-meta.txt
	@echo "PKGNAME=rust-crate-fastant_0_1_10-0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/fastant-0.1.10/crate-meta.txt
	@echo "PROC_MACRO=0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/fastant-0.1.10/crate-meta.txt

.include <bsd.port.mk>
