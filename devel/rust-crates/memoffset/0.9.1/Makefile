# crates.io: memoffset 0.9.1
# Builds a prebuilt rlib (or proc-macro .so); dependents seed CARGO_TARGET_DIR.

COMMENT =	Rust crate prebuilt rlib

PKGNAME =	rust-crate-memoffset_0_9_1-0

SUBST_VARS =		MACHINE_ARCH

CATEGORIES =	devel
HOMEPAGE =	https://crates.io/crates/memoffset
MAINTAINER =	Todd T. Fries <todd@fries.net>

PERMIT_PACKAGE =	Yes

DIST_SUBDIR =		cargo
# Required when DIST_SUBDIR is set (cargo.port.mk).
MODCARGO_DIST_SUBDIR =	cargo
# crates.io serves memoffset/0.9.1/download (403 on …/name-ver.tar.gz).
SITES =			https://crates.io/api/v1/crates/
DISTFILES =		memoffset-0.9.1.tar.gz{memoffset/0.9.1/download}
WRKDIST =		${WRKDIR}/memoffset-0.9.1

MODULES =		devel/cargo
CONFIGURE_STYLE =	cargo
SEPARATE_BUILD =	Yes
# Crate is the project; no extra MODCARGO_CRATES (deps come from packages).
MODCARGO_CRATES =
MODCARGO_INSTALL =	No

# Match grok-build release knobs when set by the farm/env.
MAKE_ENV +=		CARGO_INCREMENTAL=0
# Do not use farm RUSTC_WRAPPER/sccache for per-crate ports: packages are the
# cache; sccache hangs have stalled whole dpb runs.
MAKE_ENV +=		RUSTC_WRAPPER=
MAKE_ENV +=		CARGO_BUILD_RUSTC_WRAPPER=
# Older crates use #![deny(warnings)]; rustc 1.97 turns many lints into hard
# errors (elided lifetimes, unexpected_cfgs). Cap all lints so we can still
# produce the rlib/.so for offline seed.
MAKE_ENV +=		RUSTFLAGS=--cap-lints=allow
MAKE_ENV +=		CARGO_ENCODED_RUSTFLAGS=--cap-lints=allow


BUILD_DEPENDS +=	rust-crate-autocfg_1_5_0-0:devel/rust-crates/autocfg/1.5.0

# Direct registry deps: seed their rlibs/fingerprints before building this crate.
_RUST_CRATE_ARCH =	${MACHINE_ARCH}
_RUST_CRATE_LIBDIR =	${LOCALBASE}/lib/rust-crates/${_RUST_CRATE_ARCH}
_RUST_CRATE_SHARE =	${LOCALBASE}/share/modcargo-crates

post-extract:
	@mkdir -p ${WRKDIR}/vendor
	# This crate (+ .cargo-checksum.json for offline vendor)
	@rm -rf ${WRKDIR}/vendor/memoffset-0.9.1
	@cp -a ${WRKSRC} ${WRKDIR}/vendor/memoffset-0.9.1
	@${LOCALBASE}/bin/cargo-generate-vendor ${FULLDISTDIR}/memoffset-0.9.1.tar.gz \
		${WRKDIR}/vendor/memoffset-0.9.1
	# Dep sources from installed rust-crate-* packages (or fail if missing)
	@if [ -d ${_RUST_CRATE_SHARE}/autocfg-1.5.0 ]; then \
		ln -sfn ${_RUST_CRATE_SHARE}/autocfg-1.5.0 ${WRKDIR}/vendor/autocfg-1.5.0; \
	elif [ -f ${_RUST_CRATE_SHARE}/autocfg-1.5.0.tar.gz ]; then \
		tar xzf ${_RUST_CRATE_SHARE}/autocfg-1.5.0.tar.gz -C ${WRKDIR}/vendor; \
		if [ ! -d ${WRKDIR}/vendor/autocfg-1.5.0 ] && [ -d ${WRKDIR}/vendor/autocfg-1.5.0 ]; then \
			mv ${WRKDIR}/vendor/autocfg-1.5.0 ${WRKDIR}/vendor/autocfg-1.5.0; \
		fi; \
		${LOCALBASE}/bin/cargo-generate-vendor ${_RUST_CRATE_SHARE}/autocfg-1.5.0.tar.gz ${WRKDIR}/vendor/autocfg-1.5.0 2>/dev/null || true; \
	else \
		echo "missing dep autocfg-1.5.0" >&2; exit 1; \
	fi
	# Strip optional/dev deps from EVERY vendored Cargo.toml, drop feature
	# activations that no longer exist on deps, and refresh
	# .cargo-checksum.json (editing Cargo.toml invalidates the hash).
	@python3 ${.CURDIR}/files/strip-optional-deps.py --all ${WRKDIR}/vendor

	# Pin graph so cargo does not try to resolve optional/unused deps offline.
	@cp ${.CURDIR}/files/Cargo.lock ${WRKDIR}/vendor/memoffset-0.9.1/Cargo.lock
	@mkdir -p ${WRKDIR}/.cargo
	@echo "[build]" >${WRKDIR}/.cargo/config.toml
	@echo "rustc = '${LOCALBASE}/bin/rustc'" >>${WRKDIR}/.cargo/config.toml
	@echo "[net]" >>${WRKDIR}/.cargo/config.toml
	@echo "offline = true" >>${WRKDIR}/.cargo/config.toml
	@echo "[source.modcargo]" >>${WRKDIR}/.cargo/config.toml
	@echo "directory = '${WRKDIR}/vendor'" >>${WRKDIR}/.cargo/config.toml
	@echo "[source.crates-io]" >>${WRKDIR}/.cargo/config.toml
	@echo "replace-with = 'modcargo'" >>${WRKDIR}/.cargo/config.toml
	@ln -sf ${WRKDIR}/.cargo/config.toml ${WRKDIR}/.cargo/config

pre-build:
	@mkdir -p ${WRKDIR}/.cargo
	@echo "[build]" >${WRKDIR}/.cargo/config.toml
	@echo "rustc = '${LOCALBASE}/bin/rustc'" >>${WRKDIR}/.cargo/config.toml
	@echo "[net]" >>${WRKDIR}/.cargo/config.toml
	@echo "offline = true" >>${WRKDIR}/.cargo/config.toml
	@echo "[source.modcargo]" >>${WRKDIR}/.cargo/config.toml
	@echo "directory = '${WRKDIR}/vendor'" >>${WRKDIR}/.cargo/config.toml
	@echo "[source.crates-io]" >>${WRKDIR}/.cargo/config.toml
	@echo "replace-with = 'modcargo'" >>${WRKDIR}/.cargo/config.toml
	@ln -sf ${WRKDIR}/.cargo/config.toml ${WRKDIR}/.cargo/config
	@mkdir -p ${MODCARGO_TARGET_DIR}/release/deps
	@mkdir -p ${MODCARGO_TARGET_DIR}/release/.fingerprint
	# Seed dep cargo artifacts so cargo often skips recompiling them.
	@if [ -d ${_RUST_CRATE_LIBDIR}/autocfg-1.5.0/deps ]; then \
		cp -Rp ${_RUST_CRATE_LIBDIR}/autocfg-1.5.0/deps/. ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true; \
	fi
	@cp -f ${_RUST_CRATE_LIBDIR}/autocfg-1.5.0/lib*.rlib ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/autocfg-1.5.0/lib*.so ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/autocfg-1.5.0/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	# Package files are often mode 444; cargo must be able to write .d / replace units.
	@chmod -R u+w ${MODCARGO_TARGET_DIR} 2>/dev/null || true

do-build:
	@cd ${WRKDIR}/vendor/memoffset-0.9.1 && \
		${SETENV} ${MAKE_ENV} \
		RUSTC_WRAPPER= \
		CARGO_BUILD_RUSTC_WRAPPER= \
		RUSTFLAGS='--cap-lints=allow' \
		CARGO_ENCODED_RUSTFLAGS='--cap-lints=allow' \
		CARGO_TARGET_DIR=${MODCARGO_TARGET_DIR} \
		CARGO_HOME=${WRKDIR}/cargo-home \
		CARGO_NET_OFFLINE=true \
		${LOCALBASE}/bin/cargo build --release --offline \
			--manifest-path Cargo.toml \
			--config ${WRKDIR}/.cargo/config.toml \
			

do-install:
	${INSTALL_DATA_DIR} ${PREFIX}/share/modcargo-crates
	# Sanitize "+" in installed paths (pkg_create treats + as flavor).
	${INSTALL_DATA} ${FULLDISTDIR}/memoffset-0.9.1.tar.gz \
		${PREFIX}/share/modcargo-crates/memoffset-0.9.1.tar.gz
	${INSTALL_DATA_DIR} ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/memoffset-0.9.1/deps
	# Prefer rlib; proc-macros emit .so only. [lib] name may differ from package.
	@art=""; \
	for cand in \
		${MODCARGO_TARGET_DIR}/release/deps/libmemoffset-*.rlib \
		${MODCARGO_TARGET_DIR}/release/libmemoffset.rlib \
		${MODCARGO_TARGET_DIR}/release/deps/libmemoffset-*.so \
		${MODCARGO_TARGET_DIR}/release/libmemoffset.so \
		${MODCARGO_TARGET_DIR}/release/deps/libmemoffset-*.rmeta \
		${MODCARGO_TARGET_DIR}/release/libmemoffset.rmeta; do \
		if [ -f "$$cand" ]; then art=$$cand; break; fi; \
	done; \
	if [ -z "$$art" ]; then \
		for cand in \
			${MODCARGO_TARGET_DIR}/release/lib*.rlib \
			${MODCARGO_TARGET_DIR}/release/lib*.so; do \
			if [ -f "$$cand" ]; then \
				echo "ERROR: memoffset built $$cand but port rust_lib=memoffset (Cargo.toml [lib] name?)" >&2; \
				echo "ERROR: regen with gen-rust-crate-ports.py (do not hand-edit PLIST)" >&2; \
				exit 1; \
			fi; \
		done; \
		echo "ERROR: no rlib/so/rmeta for memoffset (libmemoffset.*)" >&2; \
		ls -la ${MODCARGO_TARGET_DIR}/release/ ${MODCARGO_TARGET_DIR}/release/deps/ 2>&1 | head -40 >&2; \
		exit 1; \
	fi; \
	case "$$art" in \
	*.rlib) ext=rlib ;; \
	*.so)   ext=so ;; \
	*.rmeta) ext=rmeta ;; \
	*)      ext=rlib ;; \
	esac; \
	want_ext=rlib; \
	if [ "0" = "1" ]; then want_ext=so; fi; \
	if [ "$$ext" != "$$want_ext" ]; then \
		echo "ERROR: memoffset produced .$$ext but PROC_MACRO=0 expects .$$want_ext" >&2; \
		echo "ERROR: regen with gen-rust-crate-ports.py (do not hand-edit PLIST)" >&2; \
		ls -la ${MODCARGO_TARGET_DIR}/release/ ${MODCARGO_TARGET_DIR}/release/deps/ 2>&1 | head -40 >&2; \
		exit 1; \
	fi; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/memoffset-0.9.1/libmemoffset.$$ext; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/memoffset-0.9.1/deps/
	@rmeta=`ls ${MODCARGO_TARGET_DIR}/release/deps/libmemoffset-*.rmeta 2>/dev/null | head -1`; \
	if [ -n "$$rmeta" ]; then \
		${INSTALL_DATA} $$rmeta \
			${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/memoffset-0.9.1/libmemoffset.rmeta; \
	fi
	@echo "NAME=memoffset" > ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/memoffset-0.9.1/crate-meta.txt
	@echo "VERSION=0.9.1" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/memoffset-0.9.1/crate-meta.txt
	@echo "RUST_LIB=memoffset" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/memoffset-0.9.1/crate-meta.txt
	@echo "PKGNAME=rust-crate-memoffset_0_9_1-0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/memoffset-0.9.1/crate-meta.txt
	@echo "PROC_MACRO=0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/memoffset-0.9.1/crate-meta.txt

.include <bsd.port.mk>
