	fi
	@cp -f ${_RUST_CRATE_LIBDIR}/quote-1.0.45/lib*.rlib ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/quote-1.0.45/lib*.so ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
