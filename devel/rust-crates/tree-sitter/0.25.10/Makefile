do-build:
	@cd ${WRKDIR}/vendor/tree-sitter-0.25.10 && \
		${SETENV} ${MAKE_ENV} \
		RUSTC_WRAPPER= \
		CARGO_BUILD_RUSTC_WRAPPER= \
		RUSTFLAGS='--cap-lints=allow' \
		CARGO_ENCODED_RUSTFLAGS='--cap-lints=allow' \
		CARGO_TARGET_DIR=${MODCARGO_TARGET_DIR} \
		CARGO_HOME=${WRKDIR}/cargo-home \
		CARGO_NET_OFFLINE=true \
		${LOCALBASE}/bin/cargo build --release --offline \
			--manifest-path Cargo.toml \
			--config ${WRKDIR}/.cargo/config.toml \
			

do-install:
	${INSTALL_DATA_DIR} ${PREFIX}/share/modcargo-crates
	# Sanitize "+" in installed paths (pkg_create treats + as flavor).
	${INSTALL_DATA} ${FULLDISTDIR}/tree-sitter-0.25.10.tar.gz \
		${PREFIX}/share/modcargo-crates/tree-sitter-0.25.10.tar.gz
	${INSTALL_DATA_DIR} ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/tree-sitter-0.25.10/deps
	# Prefer rlib; proc-macros emit .so only. [lib] name may differ from package.
	@art=""; \
	for cand in \
		${MODCARGO_TARGET_DIR}/release/deps/libtree_sitter-*.rlib \
		${MODCARGO_TARGET_DIR}/release/libtree_sitter.rlib \
		${MODCARGO_TARGET_DIR}/release/deps/libtree_sitter-*.so \
		${MODCARGO_TARGET_DIR}/release/libtree_sitter.so \
		${MODCARGO_TARGET_DIR}/release/deps/libtree_sitter-*.rmeta \
		${MODCARGO_TARGET_DIR}/release/libtree_sitter.rmeta; do \
		if [ -f "$$cand" ]; then art=$$cand; break; fi; \
	done; \
	if [ -z "$$art" ]; then \
		echo "ERROR: no rlib/so/rmeta for tree-sitter (libtree_sitter.*)" >&2; \
		ls -la ${MODCARGO_TARGET_DIR}/release/ ${MODCARGO_TARGET_DIR}/release/deps/ 2>&1 | head -40 >&2; \
		exit 1; \
	fi; \
	case "$$art" in \
	*.rlib) ext=rlib ;; \
	*.so)   ext=so ;; \
	*.rmeta) ext=rmeta ;; \
	*)      ext=rlib ;; \
	esac; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/tree-sitter-0.25.10/libtree_sitter.$$ext; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/tree-sitter-0.25.10/deps/
	@rmeta=`ls ${MODCARGO_TARGET_DIR}/release/deps/libtree_sitter-*.rmeta 2>/dev/null | head -1`; \
	if [ -n "$$rmeta" ]; then \
		${INSTALL_DATA} $$rmeta \
			${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/tree-sitter-0.25.10/libtree_sitter.rmeta; \
	fi
	@echo "NAME=tree-sitter" > ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/tree-sitter-0.25.10/crate-meta.txt
	@echo "VERSION=0.25.10" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/tree-sitter-0.25.10/crate-meta.txt
	@echo "RUST_LIB=tree_sitter" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/tree-sitter-0.25.10/crate-meta.txt
	@echo "PKGNAME=rust-crate-tree_sitter_0_25_10-0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/tree-sitter-0.25.10/crate-meta.txt
	@echo "PROC_MACRO=0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/tree-sitter-0.25.10/crate-meta.txt

.include <bsd.port.mk>
