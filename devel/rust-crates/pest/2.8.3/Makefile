PERMIT_PACKAGE =	Yes

DIST_SUBDIR =		cargo
# Required when DIST_SUBDIR is set (cargo.port.mk).
MODCARGO_DIST_SUBDIR =	cargo
SITES =			https://static.crates.io/crates/pest/
DISTFILES =		pest-2.8.3.tar.gz
WRKDIST =		${WRKDIR}/pest-2.8.3

MODULES =		devel/cargo
CONFIGURE_STYLE =	cargo
SEPARATE_BUILD =	Yes
# Crate is the project; no extra MODCARGO_CRATES (deps come from packages).
MODCARGO_CRATES =
MODCARGO_INSTALL =	No

# Match grok-build release knobs when set by the farm/env.
MAKE_ENV +=		CARGO_INCREMENTAL=0
# Do not use farm RUSTC_WRAPPER/sccache for per-crate ports: packages are the
# cache; sccache hangs have stalled whole dpb runs.
MAKE_ENV +=		RUSTC_WRAPPER=
MAKE_ENV +=		CARGO_BUILD_RUSTC_WRAPPER=
# Older crates use #![deny(warnings)]; rustc 1.97 turns many lints into hard
# errors (elided lifetimes, unexpected_cfgs). Cap all lints so we can still
# produce the rlib/.so for offline seed.
MAKE_ENV +=		RUSTFLAGS=--cap-lints=allow
MAKE_ENV +=		CARGO_ENCODED_RUSTFLAGS=--cap-lints=allow


BUILD_DEPENDS +=	rust-crate-memchr_2_8_2-0:devel/rust-crates/memchr/2.8.2
BUILD_DEPENDS +=	rust-crate-ucd_trie_0_1_7-0:devel/rust-crates/ucd-trie/0.1.7

# Direct registry deps: seed their rlibs/fingerprints before building this crate.
_RUST_CRATE_ARCH =	${MACHINE_ARCH}
_RUST_CRATE_LIBDIR =	${LOCALBASE}/lib/rust-crates/${_RUST_CRATE_ARCH}
_RUST_CRATE_SHARE =	${LOCALBASE}/share/modcargo-crates

post-extract:
	@mkdir -p ${WRKDIR}/vendor
	# This crate (+ .cargo-checksum.json for offline vendor)
	@rm -rf ${WRKDIR}/vendor/pest-2.8.3
	@cp -a ${WRKSRC} ${WRKDIR}/vendor/pest-2.8.3
	@${LOCALBASE}/bin/cargo-generate-vendor ${FULLDISTDIR}/pest-2.8.3.tar.gz \
		${WRKDIR}/vendor/pest-2.8.3
	# Dep sources from installed rust-crate-* packages (or fail if missing)
	@if [ -d ${_RUST_CRATE_SHARE}/memchr-2.8.2 ]; then \
		ln -sfn ${_RUST_CRATE_SHARE}/memchr-2.8.2 ${WRKDIR}/vendor/memchr-2.8.2; \
	elif [ -f ${_RUST_CRATE_SHARE}/memchr-2.8.2.tar.gz ]; then \
		tar xzf ${_RUST_CRATE_SHARE}/memchr-2.8.2.tar.gz -C ${WRKDIR}/vendor; \
		if [ ! -d ${WRKDIR}/vendor/memchr-2.8.2 ] && [ -d ${WRKDIR}/vendor/memchr-2.8.2 ]; then \
			mv ${WRKDIR}/vendor/memchr-2.8.2 ${WRKDIR}/vendor/memchr-2.8.2; \
		fi; \
		${LOCALBASE}/bin/cargo-generate-vendor ${_RUST_CRATE_SHARE}/memchr-2.8.2.tar.gz ${WRKDIR}/vendor/memchr-2.8.2 2>/dev/null || true; \
	else \
		echo "missing dep memchr-2.8.2" >&2; exit 1; \
	fi
	@if [ -d ${_RUST_CRATE_SHARE}/ucd-trie-0.1.7 ]; then \
		ln -sfn ${_RUST_CRATE_SHARE}/ucd-trie-0.1.7 ${WRKDIR}/vendor/ucd-trie-0.1.7; \
	elif [ -f ${_RUST_CRATE_SHARE}/ucd-trie-0.1.7.tar.gz ]; then \
		tar xzf ${_RUST_CRATE_SHARE}/ucd-trie-0.1.7.tar.gz -C ${WRKDIR}/vendor; \
		if [ ! -d ${WRKDIR}/vendor/ucd-trie-0.1.7 ] && [ -d ${WRKDIR}/vendor/ucd-trie-0.1.7 ]; then \
			mv ${WRKDIR}/vendor/ucd-trie-0.1.7 ${WRKDIR}/vendor/ucd-trie-0.1.7; \
		fi; \
		${LOCALBASE}/bin/cargo-generate-vendor ${_RUST_CRATE_SHARE}/ucd-trie-0.1.7.tar.gz ${WRKDIR}/vendor/ucd-trie-0.1.7 2>/dev/null || true; \
	else \
		echo "missing dep ucd-trie-0.1.7" >&2; exit 1; \
	fi
	# Strip optional/dev deps from EVERY vendored Cargo.toml, drop feature
	# activations that no longer exist on deps, and refresh
	# .cargo-checksum.json (editing Cargo.toml invalidates the hash).
	@python3 ${.CURDIR}/files/strip-optional-deps.py --all ${WRKDIR}/vendor

	# Pin graph so cargo does not try to resolve optional/unused deps offline.
	@cp ${.CURDIR}/files/Cargo.lock ${WRKDIR}/vendor/pest-2.8.3/Cargo.lock
	@mkdir -p ${WRKDIR}/.cargo
	@echo "[build]" >${WRKDIR}/.cargo/config.toml
	@echo "rustc = '${LOCALBASE}/bin/rustc'" >>${WRKDIR}/.cargo/config.toml
	@echo "[net]" >>${WRKDIR}/.cargo/config.toml
	@echo "offline = true" >>${WRKDIR}/.cargo/config.toml
	@echo "[source.modcargo]" >>${WRKDIR}/.cargo/config.toml
	@echo "directory = '${WRKDIR}/vendor'" >>${WRKDIR}/.cargo/config.toml
	@echo "[source.crates-io]" >>${WRKDIR}/.cargo/config.toml
	@echo "replace-with = 'modcargo'" >>${WRKDIR}/.cargo/config.toml
	@ln -sf ${WRKDIR}/.cargo/config.toml ${WRKDIR}/.cargo/config

pre-build:
	@mkdir -p ${WRKDIR}/.cargo
	@echo "[build]" >${WRKDIR}/.cargo/config.toml
	@echo "rustc = '${LOCALBASE}/bin/rustc'" >>${WRKDIR}/.cargo/config.toml
	@echo "[net]" >>${WRKDIR}/.cargo/config.toml
	@echo "offline = true" >>${WRKDIR}/.cargo/config.toml
	@echo "[source.modcargo]" >>${WRKDIR}/.cargo/config.toml
	@echo "directory = '${WRKDIR}/vendor'" >>${WRKDIR}/.cargo/config.toml
	@echo "[source.crates-io]" >>${WRKDIR}/.cargo/config.toml
	@echo "replace-with = 'modcargo'" >>${WRKDIR}/.cargo/config.toml
	@ln -sf ${WRKDIR}/.cargo/config.toml ${WRKDIR}/.cargo/config
	@mkdir -p ${MODCARGO_TARGET_DIR}/release/deps
	@mkdir -p ${MODCARGO_TARGET_DIR}/release/.fingerprint
	# Seed dep cargo artifacts so cargo often skips recompiling them.
	@if [ -d ${_RUST_CRATE_LIBDIR}/memchr-2.8.2/deps ]; then \
		cp -Rp ${_RUST_CRATE_LIBDIR}/memchr-2.8.2/deps/. ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true; \
	fi
	@cp -f ${_RUST_CRATE_LIBDIR}/memchr-2.8.2/lib*.rlib ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/memchr-2.8.2/lib*.so ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/memchr-2.8.2/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@if [ -d ${_RUST_CRATE_LIBDIR}/ucd-trie-0.1.7/deps ]; then \
		cp -Rp ${_RUST_CRATE_LIBDIR}/ucd-trie-0.1.7/deps/. ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true; \
	fi
	@cp -f ${_RUST_CRATE_LIBDIR}/ucd-trie-0.1.7/lib*.rlib ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/ucd-trie-0.1.7/lib*.so ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/ucd-trie-0.1.7/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	# Package files are often mode 444; cargo must be able to write .d / replace units.
	@chmod -R u+w ${MODCARGO_TARGET_DIR} 2>/dev/null || true

do-build:
	@cd ${WRKDIR}/vendor/pest-2.8.3 && \
		${SETENV} ${MAKE_ENV} \
		RUSTC_WRAPPER= \
		CARGO_BUILD_RUSTC_WRAPPER= \
		RUSTFLAGS='--cap-lints=allow' \
		CARGO_ENCODED_RUSTFLAGS='--cap-lints=allow' \
		CARGO_TARGET_DIR=${MODCARGO_TARGET_DIR} \
		CARGO_HOME=${WRKDIR}/cargo-home \
		CARGO_NET_OFFLINE=true \
		${LOCALBASE}/bin/cargo build --release --offline \
			--manifest-path Cargo.toml \
			--config ${WRKDIR}/.cargo/config.toml \
			

do-install:
	${INSTALL_DATA_DIR} ${PREFIX}/share/modcargo-crates
	# Sanitize "+" in installed paths (pkg_create treats + as flavor).
	${INSTALL_DATA} ${FULLDISTDIR}/pest-2.8.3.tar.gz \
		${PREFIX}/share/modcargo-crates/pest-2.8.3.tar.gz
	${INSTALL_DATA_DIR} ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/pest-2.8.3/deps
	# Prefer rlib; proc-macros emit .so only. [lib] name may differ from package.
	@art=""; \
	for cand in \
		${MODCARGO_TARGET_DIR}/release/deps/libpest-*.rlib \
		${MODCARGO_TARGET_DIR}/release/libpest.rlib \
		${MODCARGO_TARGET_DIR}/release/deps/libpest-*.so \
		${MODCARGO_TARGET_DIR}/release/libpest.so \
		${MODCARGO_TARGET_DIR}/release/deps/libpest-*.rmeta \
		${MODCARGO_TARGET_DIR}/release/libpest.rmeta; do \
		if [ -f "$$cand" ]; then art=$$cand; break; fi; \
	done; \
	if [ -z "$$art" ]; then \
		echo "ERROR: no rlib/so/rmeta for pest (libpest.*)" >&2; \
		ls -la ${MODCARGO_TARGET_DIR}/release/ ${MODCARGO_TARGET_DIR}/release/deps/ 2>&1 | head -40 >&2; \
		exit 1; \
	fi; \
	case "$$art" in \
	*.rlib) ext=rlib ;; \
	*.so)   ext=so ;; \
	*.rmeta) ext=rmeta ;; \
	*)      ext=rlib ;; \
	esac; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/pest-2.8.3/libpest.$$ext; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/pest-2.8.3/deps/
	@rmeta=`ls ${MODCARGO_TARGET_DIR}/release/deps/libpest-*.rmeta 2>/dev/null | head -1`; \
	if [ -n "$$rmeta" ]; then \
		${INSTALL_DATA} $$rmeta \
			${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/pest-2.8.3/libpest.rmeta; \
	fi
	@echo "NAME=pest" > ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/pest-2.8.3/crate-meta.txt
	@echo "VERSION=2.8.3" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/pest-2.8.3/crate-meta.txt
	@echo "RUST_LIB=pest" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/pest-2.8.3/crate-meta.txt
	@echo "PKGNAME=rust-crate-pest_2_8_3-0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/pest-2.8.3/crate-meta.txt
	@echo "PROC_MACRO=0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/pest-2.8.3/crate-meta.txt

.include <bsd.port.mk>
