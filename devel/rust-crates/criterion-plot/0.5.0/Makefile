	@echo "[source.crates-io]" >>${WRKDIR}/.cargo/config.toml
	@echo "replace-with = 'modcargo'" >>${WRKDIR}/.cargo/config.toml
	@ln -sf ${WRKDIR}/.cargo/config.toml ${WRKDIR}/.cargo/config

pre-build:
	@mkdir -p ${WRKDIR}/.cargo
	@echo "[build]" >${WRKDIR}/.cargo/config.toml
	@echo "rustc = '${LOCALBASE}/bin/rustc'" >>${WRKDIR}/.cargo/config.toml
	@echo "[net]" >>${WRKDIR}/.cargo/config.toml
	@echo "offline = true" >>${WRKDIR}/.cargo/config.toml
	@echo "[source.modcargo]" >>${WRKDIR}/.cargo/config.toml
	@echo "directory = '${WRKDIR}/vendor'" >>${WRKDIR}/.cargo/config.toml
	@echo "[source.crates-io]" >>${WRKDIR}/.cargo/config.toml
	@echo "replace-with = 'modcargo'" >>${WRKDIR}/.cargo/config.toml
	@ln -sf ${WRKDIR}/.cargo/config.toml ${WRKDIR}/.cargo/config
	@mkdir -p ${MODCARGO_TARGET_DIR}/release/deps
	@mkdir -p ${MODCARGO_TARGET_DIR}/release/.fingerprint
	# Seed dep cargo artifacts so cargo often skips recompiling them.
	@if [ -d ${_RUST_CRATE_LIBDIR}/cast-0.3.0/deps ]; then \
		cp -Rp ${_RUST_CRATE_LIBDIR}/cast-0.3.0/deps/. ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true; \
	fi
	@cp -f ${_RUST_CRATE_LIBDIR}/cast-0.3.0/lib*.rlib ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/cast-0.3.0/lib*.so ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/cast-0.3.0/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@if [ -d ${_RUST_CRATE_LIBDIR}/itertools-0.10.5/deps ]; then \
		cp -Rp ${_RUST_CRATE_LIBDIR}/itertools-0.10.5/deps/. ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true; \
	fi
	@cp -f ${_RUST_CRATE_LIBDIR}/itertools-0.10.5/lib*.rlib ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/itertools-0.10.5/lib*.so ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/itertools-0.10.5/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@if [ -d ${_RUST_CRATE_LIBDIR}/either-1.15.0/deps ]; then \
		cp -Rp ${_RUST_CRATE_LIBDIR}/either-1.15.0/deps/. ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true; \
	fi
	@cp -f ${_RUST_CRATE_LIBDIR}/either-1.15.0/lib*.rlib ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/either-1.15.0/lib*.so ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	@cp -f ${_RUST_CRATE_LIBDIR}/either-1.15.0/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	# Package files are often mode 444; cargo must be able to write .d / replace units.
	@chmod -R u+w ${MODCARGO_TARGET_DIR} 2>/dev/null || true

do-build:
	@cd ${WRKDIR}/vendor/criterion-plot-0.5.0 && \
		${SETENV} ${MAKE_ENV} \
		RUSTC_WRAPPER= \
		CARGO_BUILD_RUSTC_WRAPPER= \
		RUSTFLAGS='--cap-lints=allow' \
		CARGO_ENCODED_RUSTFLAGS='--cap-lints=allow' \
		CARGO_TARGET_DIR=${MODCARGO_TARGET_DIR} \
		CARGO_HOME=${WRKDIR}/cargo-home \
		CARGO_NET_OFFLINE=true \
		${LOCALBASE}/bin/cargo build --release --offline \
			--manifest-path Cargo.toml \
			--config ${WRKDIR}/.cargo/config.toml \
			

do-install:
	${INSTALL_DATA_DIR} ${PREFIX}/share/modcargo-crates
	# Sanitize "+" in installed paths (pkg_create treats + as flavor).
	${INSTALL_DATA} ${FULLDISTDIR}/criterion-plot-0.5.0.tar.gz \
		${PREFIX}/share/modcargo-crates/criterion-plot-0.5.0.tar.gz
	${INSTALL_DATA_DIR} ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/criterion-plot-0.5.0/deps
	# Prefer rlib; proc-macros emit .so only. [lib] name may differ from package.
	@art=""; \
	for cand in \
		${MODCARGO_TARGET_DIR}/release/deps/libcriterion_plot-*.rlib \
		${MODCARGO_TARGET_DIR}/release/libcriterion_plot.rlib \
		${MODCARGO_TARGET_DIR}/release/deps/libcriterion_plot-*.so \
		${MODCARGO_TARGET_DIR}/release/libcriterion_plot.so \
		${MODCARGO_TARGET_DIR}/release/deps/libcriterion_plot-*.rmeta \
		${MODCARGO_TARGET_DIR}/release/libcriterion_plot.rmeta; do \
		if [ -f "$$cand" ]; then art=$$cand; break; fi; \
	done; \
	if [ -z "$$art" ]; then \
		echo "ERROR: no rlib/so/rmeta for criterion-plot (libcriterion_plot.*)" >&2; \
		ls -la ${MODCARGO_TARGET_DIR}/release/ ${MODCARGO_TARGET_DIR}/release/deps/ 2>&1 | head -40 >&2; \
		exit 1; \
	fi; \
	case "$$art" in \
	*.rlib) ext=rlib ;; \
	*.so)   ext=so ;; \
	*.rmeta) ext=rmeta ;; \
	*)      ext=rlib ;; \
	esac; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/criterion-plot-0.5.0/libcriterion_plot.$$ext; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/criterion-plot-0.5.0/deps/
	@rmeta=`ls ${MODCARGO_TARGET_DIR}/release/deps/libcriterion_plot-*.rmeta 2>/dev/null | head -1`; \
	if [ -n "$$rmeta" ]; then \
		${INSTALL_DATA} $$rmeta \
			${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/criterion-plot-0.5.0/libcriterion_plot.rmeta; \
	fi
	@echo "NAME=criterion-plot" > ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/criterion-plot-0.5.0/crate-meta.txt
	@echo "VERSION=0.5.0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/criterion-plot-0.5.0/crate-meta.txt
	@echo "RUST_LIB=criterion_plot" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/criterion-plot-0.5.0/crate-meta.txt
	@echo "PKGNAME=rust-crate-criterion_plot_0_5_0-0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/criterion-plot-0.5.0/crate-meta.txt
	@echo "PROC_MACRO=0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/criterion-plot-0.5.0/crate-meta.txt

