	# Dep sources from installed rust-crate-* packages (or fail if missing)
	@if [ -d ${_RUST_CRATE_SHARE}/cast-0.3.0 ]; then \
		ln -sfn ${_RUST_CRATE_SHARE}/cast-0.3.0 ${WRKDIR}/vendor/cast-0.3.0; \
