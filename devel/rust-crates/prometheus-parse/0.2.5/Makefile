	@cp -f ${_RUST_CRATE_LIBDIR}/unicode-ident-1.0.24/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	# Package files are often mode 444; cargo must be able to write .d / replace units.
	@chmod -R u+w ${MODCARGO_TARGET_DIR} 2>/dev/null || true

do-build:
	@cd ${WRKDIR}/vendor/prometheus-parse-0.2.5 && \
		${SETENV} ${MAKE_ENV} \
		RUSTC_WRAPPER= \
		CARGO_BUILD_RUSTC_WRAPPER= \
		RUSTFLAGS='--cap-lints=allow' \
		CARGO_ENCODED_RUSTFLAGS='--cap-lints=allow' \
		CARGO_TARGET_DIR=${MODCARGO_TARGET_DIR} \
		CARGO_HOME=${WRKDIR}/cargo-home \
		CARGO_NET_OFFLINE=true \
		${LOCALBASE}/bin/cargo build --release --offline \
			--manifest-path Cargo.toml \
			--config ${WRKDIR}/.cargo/config.toml \
			

do-install:
	${INSTALL_DATA_DIR} ${PREFIX}/share/modcargo-crates
	# Sanitize "+" in installed paths (pkg_create treats + as flavor).
	${INSTALL_DATA} ${FULLDISTDIR}/prometheus-parse-0.2.5.tar.gz \
		${PREFIX}/share/modcargo-crates/prometheus-parse-0.2.5.tar.gz
	${INSTALL_DATA_DIR} ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/prometheus-parse-0.2.5/deps
	# Prefer rlib; proc-macros emit .so only. [lib] name may differ from package.
	@art=""; \
	for cand in \
		${MODCARGO_TARGET_DIR}/release/deps/libprometheus_parse-*.rlib \
		${MODCARGO_TARGET_DIR}/release/libprometheus_parse.rlib \
		${MODCARGO_TARGET_DIR}/release/deps/libprometheus_parse-*.so \
		${MODCARGO_TARGET_DIR}/release/libprometheus_parse.so \
		${MODCARGO_TARGET_DIR}/release/deps/libprometheus_parse-*.rmeta \
		${MODCARGO_TARGET_DIR}/release/libprometheus_parse.rmeta; do \
		if [ -f "$$cand" ]; then art=$$cand; break; fi; \
	done; \
	if [ -z "$$art" ]; then \
		for cand in \
			${MODCARGO_TARGET_DIR}/release/lib*.rlib \
			${MODCARGO_TARGET_DIR}/release/lib*.so; do \
			if [ -f "$$cand" ]; then \
				echo "ERROR: prometheus-parse built $$cand but port rust_lib=prometheus_parse (Cargo.toml [lib] name?)" >&2; \
				echo "ERROR: regen with gen-rust-crate-ports.py (do not hand-edit PLIST)" >&2; \
				exit 1; \
			fi; \
		done; \
		echo "ERROR: no rlib/so/rmeta for prometheus-parse (libprometheus_parse.*)" >&2; \
		ls -la ${MODCARGO_TARGET_DIR}/release/ ${MODCARGO_TARGET_DIR}/release/deps/ 2>&1 | head -40 >&2; \
		exit 1; \
	fi; \
	case "$$art" in \
	*.rlib) ext=rlib ;; \
	*.so)   ext=so ;; \
	*.rmeta) ext=rmeta ;; \
	*)      ext=rlib ;; \
	esac; \
	want_ext=rlib; \
	if [ "0" = "1" ]; then want_ext=so; fi; \
	if [ "$$ext" != "$$want_ext" ]; then \
		echo "ERROR: prometheus-parse produced .$$ext but PROC_MACRO=0 expects .$$want_ext" >&2; \
		echo "ERROR: regen with gen-rust-crate-ports.py (do not hand-edit PLIST)" >&2; \
		ls -la ${MODCARGO_TARGET_DIR}/release/ ${MODCARGO_TARGET_DIR}/release/deps/ 2>&1 | head -40 >&2; \
		exit 1; \
	fi; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/prometheus-parse-0.2.5/libprometheus_parse.$$ext; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/prometheus-parse-0.2.5/deps/
	@rmeta=`ls ${MODCARGO_TARGET_DIR}/release/deps/libprometheus_parse-*.rmeta 2>/dev/null | head -1`; \
	if [ -n "$$rmeta" ]; then \
		${INSTALL_DATA} $$rmeta \
			${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/prometheus-parse-0.2.5/libprometheus_parse.rmeta; \
	fi
	@echo "NAME=prometheus-parse" > ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/prometheus-parse-0.2.5/crate-meta.txt
	@echo "VERSION=0.2.5" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/prometheus-parse-0.2.5/crate-meta.txt
	@echo "RUST_LIB=prometheus_parse" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/prometheus-parse-0.2.5/crate-meta.txt
	@echo "PKGNAME=rust-crate-prometheus_parse_0_2_5-0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/prometheus-parse-0.2.5/crate-meta.txt
	@echo "PROC_MACRO=0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/prometheus-parse-0.2.5/crate-meta.txt

.include <bsd.port.mk>
