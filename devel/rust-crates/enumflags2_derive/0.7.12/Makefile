do-build:
	@cd ${WRKDIR}/vendor/enumflags2_derive-0.7.12 && \
		${SETENV} ${MAKE_ENV} \
		RUSTC_WRAPPER= \
		CARGO_BUILD_RUSTC_WRAPPER= \
		RUSTFLAGS='--cap-lints=allow' \
		CARGO_ENCODED_RUSTFLAGS='--cap-lints=allow' \
		CARGO_TARGET_DIR=${MODCARGO_TARGET_DIR} \
		CARGO_HOME=${WRKDIR}/cargo-home \
		CARGO_NET_OFFLINE=true \
		${LOCALBASE}/bin/cargo build --release --offline \
			--manifest-path Cargo.toml \
			--config ${WRKDIR}/.cargo/config.toml \
			

do-install:
	${INSTALL_DATA_DIR} ${PREFIX}/share/modcargo-crates
	# Sanitize "+" in installed paths (pkg_create treats + as flavor).
	${INSTALL_DATA} ${FULLDISTDIR}/enumflags2_derive-0.7.12.tar.gz \
		${PREFIX}/share/modcargo-crates/enumflags2_derive-0.7.12.tar.gz
	${INSTALL_DATA_DIR} ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/enumflags2_derive-0.7.12/deps
	# Prefer rlib; proc-macros emit .so only. [lib] name may differ from package.
	@art=""; \
	for cand in \
		${MODCARGO_TARGET_DIR}/release/deps/libenumflags2_derive-*.rlib \
		${MODCARGO_TARGET_DIR}/release/libenumflags2_derive.rlib \
		${MODCARGO_TARGET_DIR}/release/deps/libenumflags2_derive-*.so \
		${MODCARGO_TARGET_DIR}/release/libenumflags2_derive.so \
		${MODCARGO_TARGET_DIR}/release/deps/libenumflags2_derive-*.rmeta \
		${MODCARGO_TARGET_DIR}/release/libenumflags2_derive.rmeta; do \
		if [ -f "$$cand" ]; then art=$$cand; break; fi; \
	done; \
	if [ -z "$$art" ]; then \
		echo "ERROR: no rlib/so/rmeta for enumflags2_derive (libenumflags2_derive.*)" >&2; \
		ls -la ${MODCARGO_TARGET_DIR}/release/ ${MODCARGO_TARGET_DIR}/release/deps/ 2>&1 | head -40 >&2; \
		exit 1; \
	fi; \
	case "$$art" in \
	*.rlib) ext=rlib ;; \
	*.so)   ext=so ;; \
	*.rmeta) ext=rmeta ;; \
	*)      ext=rlib ;; \
	esac; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/enumflags2_derive-0.7.12/libenumflags2_derive.$$ext; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/enumflags2_derive-0.7.12/deps/
	@rmeta=`ls ${MODCARGO_TARGET_DIR}/release/deps/libenumflags2_derive-*.rmeta 2>/dev/null | head -1`; \
	if [ -n "$$rmeta" ]; then \
		${INSTALL_DATA} $$rmeta \
			${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/enumflags2_derive-0.7.12/libenumflags2_derive.rmeta; \
	fi
	@echo "NAME=enumflags2_derive" > ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/enumflags2_derive-0.7.12/crate-meta.txt
	@echo "VERSION=0.7.12" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/enumflags2_derive-0.7.12/crate-meta.txt
	@echo "RUST_LIB=enumflags2_derive" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/enumflags2_derive-0.7.12/crate-meta.txt
	@echo "PKGNAME=rust-crate-enumflags2_derive_0_7_12-0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/enumflags2_derive-0.7.12/crate-meta.txt
	@echo "PROC_MACRO=1" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/enumflags2_derive-0.7.12/crate-meta.txt

