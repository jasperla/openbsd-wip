# Direct registry deps: seed their rlibs/fingerprints before building this crate.
_RUST_CRATE_ARCH =	${MACHINE_ARCH}
_RUST_CRATE_LIBDIR =	${LOCALBASE}/lib/rust-crates/${_RUST_CRATE_ARCH}
_RUST_CRATE_SHARE =	${LOCALBASE}/share/modcargo-crates

post-extract:
	@mkdir -p ${WRKDIR}/vendor
	# This crate (+ .cargo-checksum.json for offline vendor)
	@rm -rf ${WRKDIR}/vendor/pdf_oxide-0.3.46
	@cp -a ${WRKSRC} ${WRKDIR}/vendor/pdf_oxide-0.3.46
	@${LOCALBASE}/bin/cargo-generate-vendor ${FULLDISTDIR}/pdf_oxide-0.3.46.tar.gz \
		${WRKDIR}/vendor/pdf_oxide-0.3.46
	# Dep sources from installed rust-crate-* packages (or fail if missing)
	@if [ -d ${_RUST_CRATE_SHARE}/aes-0.9.0 ]; then \
		ln -sfn ${_RUST_CRATE_SHARE}/aes-0.9.0 ${WRKDIR}/vendor/aes-0.9.0; \
	elif [ -f ${_RUST_CRATE_SHARE}/aes-0.9.0.tar.gz ]; then \
		tar xzf ${_RUST_CRATE_SHARE}/aes-0.9.0.tar.gz -C ${WRKDIR}/vendor; \
		if [ ! -d ${WRKDIR}/vendor/aes-0.9.0 ] && [ -d ${WRKDIR}/vendor/aes-0.9.0 ]; then \
			mv ${WRKDIR}/vendor/aes-0.9.0 ${WRKDIR}/vendor/aes-0.9.0; \
		fi; \
		${LOCALBASE}/bin/cargo-generate-vendor ${_RUST_CRATE_SHARE}/aes-0.9.0.tar.gz ${WRKDIR}/vendor/aes-0.9.0 2>/dev/null || true; \
	else \
		echo "missing dep aes-0.9.0" >&2; exit 1; \
	fi
	@if [ -d ${_RUST_CRATE_SHARE}/base64-0.22.1 ]; then \
		ln -sfn ${_RUST_CRATE_SHARE}/base64-0.22.1 ${WRKDIR}/vendor/base64-0.22.1; \
	elif [ -f ${_RUST_CRATE_SHARE}/base64-0.22.1.tar.gz ]; then \
