do-build:
	@cd ${WRKDIR}/vendor/agent-client-protocol-0.10.4 && \
		${SETENV} ${MAKE_ENV} \
		RUSTC_WRAPPER= \
		CARGO_BUILD_RUSTC_WRAPPER= \
		RUSTFLAGS='--cap-lints=allow' \
		CARGO_ENCODED_RUSTFLAGS='--cap-lints=allow' \
		CARGO_TARGET_DIR=${MODCARGO_TARGET_DIR} \
		CARGO_HOME=${WRKDIR}/cargo-home \
		CARGO_NET_OFFLINE=true \
		${LOCALBASE}/bin/cargo build --release --offline \
			--manifest-path Cargo.toml \
			--config ${WRKDIR}/.cargo/config.toml \
			

do-install:
	${INSTALL_DATA_DIR} ${PREFIX}/share/modcargo-crates
	# Sanitize "+" in installed paths (pkg_create treats + as flavor).
	${INSTALL_DATA} ${FULLDISTDIR}/agent-client-protocol-0.10.4.tar.gz \
		${PREFIX}/share/modcargo-crates/agent-client-protocol-0.10.4.tar.gz
	${INSTALL_DATA_DIR} ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/agent-client-protocol-0.10.4/deps
	# Prefer rlib; proc-macros emit .so only. [lib] name may differ from package.
	@art=""; \
	for cand in \
		${MODCARGO_TARGET_DIR}/release/deps/libagent_client_protocol-*.rlib \
		${MODCARGO_TARGET_DIR}/release/libagent_client_protocol.rlib \
		${MODCARGO_TARGET_DIR}/release/deps/libagent_client_protocol-*.so \
		${MODCARGO_TARGET_DIR}/release/libagent_client_protocol.so \
		${MODCARGO_TARGET_DIR}/release/deps/libagent_client_protocol-*.rmeta \
		${MODCARGO_TARGET_DIR}/release/libagent_client_protocol.rmeta; do \
		if [ -f "$$cand" ]; then art=$$cand; break; fi; \
	done; \
	if [ -z "$$art" ]; then \
		echo "ERROR: no rlib/so/rmeta for agent-client-protocol (libagent_client_protocol.*)" >&2; \
		ls -la ${MODCARGO_TARGET_DIR}/release/ ${MODCARGO_TARGET_DIR}/release/deps/ 2>&1 | head -40 >&2; \
		exit 1; \
	fi; \
	case "$$art" in \
	*.rlib) ext=rlib ;; \
	*.so)   ext=so ;; \
	*.rmeta) ext=rmeta ;; \
	*)      ext=rlib ;; \
	esac; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/agent-client-protocol-0.10.4/libagent_client_protocol.$$ext; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/agent-client-protocol-0.10.4/deps/
	@rmeta=`ls ${MODCARGO_TARGET_DIR}/release/deps/libagent_client_protocol-*.rmeta 2>/dev/null | head -1`; \
	if [ -n "$$rmeta" ]; then \
		${INSTALL_DATA} $$rmeta \
			${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/agent-client-protocol-0.10.4/libagent_client_protocol.rmeta; \
	fi
	@echo "NAME=agent-client-protocol" > ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/agent-client-protocol-0.10.4/crate-meta.txt
	@echo "VERSION=0.10.4" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/agent-client-protocol-0.10.4/crate-meta.txt
	@echo "RUST_LIB=agent_client_protocol" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/agent-client-protocol-0.10.4/crate-meta.txt
	@echo "PKGNAME=rust-crate-agent_client_protocol_0_10_4-0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/agent-client-protocol-0.10.4/crate-meta.txt
	@echo "PROC_MACRO=0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/agent-client-protocol-0.10.4/crate-meta.txt

