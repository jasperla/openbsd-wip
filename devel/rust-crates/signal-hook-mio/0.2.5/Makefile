do-build:
	@cd ${WRKDIR}/vendor/signal-hook-mio-0.2.5 && \
		${SETENV} ${MAKE_ENV} \
		RUSTC_WRAPPER= \
		CARGO_BUILD_RUSTC_WRAPPER= \
		RUSTFLAGS='--cap-lints=allow' \
		CARGO_ENCODED_RUSTFLAGS='--cap-lints=allow' \
		CARGO_TARGET_DIR=${MODCARGO_TARGET_DIR} \
		CARGO_HOME=${WRKDIR}/cargo-home \
		CARGO_NET_OFFLINE=true \
		${LOCALBASE}/bin/cargo build --release --offline \
			--manifest-path Cargo.toml \
			--config ${WRKDIR}/.cargo/config.toml \
			

do-install:
	${INSTALL_DATA_DIR} ${PREFIX}/share/modcargo-crates
	# Sanitize "+" in installed paths (pkg_create treats + as flavor).
	${INSTALL_DATA} ${FULLDISTDIR}/signal-hook-mio-0.2.5.tar.gz \
		${PREFIX}/share/modcargo-crates/signal-hook-mio-0.2.5.tar.gz
	${INSTALL_DATA_DIR} ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/signal-hook-mio-0.2.5/deps
	# Prefer rlib; proc-macros emit .so only. [lib] name may differ from package.
	@art=""; \
	for cand in \
		${MODCARGO_TARGET_DIR}/release/deps/libsignal_hook_mio-*.rlib \
		${MODCARGO_TARGET_DIR}/release/libsignal_hook_mio.rlib \
		${MODCARGO_TARGET_DIR}/release/deps/libsignal_hook_mio-*.so \
		${MODCARGO_TARGET_DIR}/release/libsignal_hook_mio.so \
		${MODCARGO_TARGET_DIR}/release/deps/libsignal_hook_mio-*.rmeta \
		${MODCARGO_TARGET_DIR}/release/libsignal_hook_mio.rmeta; do \
		if [ -f "$$cand" ]; then art=$$cand; break; fi; \
	done; \
	if [ -z "$$art" ]; then \
		echo "ERROR: no rlib/so/rmeta for signal-hook-mio (libsignal_hook_mio.*)" >&2; \
		ls -la ${MODCARGO_TARGET_DIR}/release/ ${MODCARGO_TARGET_DIR}/release/deps/ 2>&1 | head -40 >&2; \
		exit 1; \
	fi; \
	case "$$art" in \
	*.rlib) ext=rlib ;; \
	*.so)   ext=so ;; \
	*.rmeta) ext=rmeta ;; \
	*)      ext=rlib ;; \
	esac; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/signal-hook-mio-0.2.5/libsignal_hook_mio.$$ext; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/signal-hook-mio-0.2.5/deps/
	@rmeta=`ls ${MODCARGO_TARGET_DIR}/release/deps/libsignal_hook_mio-*.rmeta 2>/dev/null | head -1`; \
	if [ -n "$$rmeta" ]; then \
		${INSTALL_DATA} $$rmeta \
			${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/signal-hook-mio-0.2.5/libsignal_hook_mio.rmeta; \
	fi
	@echo "NAME=signal-hook-mio" > ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/signal-hook-mio-0.2.5/crate-meta.txt
	@echo "VERSION=0.2.5" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/signal-hook-mio-0.2.5/crate-meta.txt
	@echo "RUST_LIB=signal_hook_mio" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/signal-hook-mio-0.2.5/crate-meta.txt
	@echo "PKGNAME=rust-crate-signal_hook_mio_0_2_5-0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/signal-hook-mio-0.2.5/crate-meta.txt
	@echo "PROC_MACRO=0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/signal-hook-mio-0.2.5/crate-meta.txt

.include <bsd.port.mk>
