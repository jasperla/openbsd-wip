	@if [ -d ${_RUST_CRATE_LIBDIR}/mio-1.2.1/deps ]; then \
		cp -Rp ${_RUST_CRATE_LIBDIR}/mio-1.2.1/deps/. ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true; \
