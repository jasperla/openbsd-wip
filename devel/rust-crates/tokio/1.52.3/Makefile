	@cp -f ${_RUST_CRATE_LIBDIR}/unicode-ident-1.0.24/lib*.rmeta ${MODCARGO_TARGET_DIR}/release/deps/ 2>/dev/null || true
	# Package files are often mode 444; cargo must be able to write .d / replace units.
	@chmod -R u+w ${MODCARGO_TARGET_DIR} 2>/dev/null || true

do-build:
	@cd ${WRKDIR}/vendor/tokio-1.52.3 && \
		${SETENV} ${MAKE_ENV} \
		RUSTC_WRAPPER= \
		CARGO_BUILD_RUSTC_WRAPPER= \
		RUSTFLAGS='--cap-lints=allow' \
		CARGO_ENCODED_RUSTFLAGS='--cap-lints=allow' \
		CARGO_TARGET_DIR=${MODCARGO_TARGET_DIR} \
		CARGO_HOME=${WRKDIR}/cargo-home \
		CARGO_NET_OFFLINE=true \
		${LOCALBASE}/bin/cargo build --release --offline \
			--manifest-path Cargo.toml \
			--config ${WRKDIR}/.cargo/config.toml \
			

do-install:
	${INSTALL_DATA_DIR} ${PREFIX}/share/modcargo-crates
	# Sanitize "+" in installed paths (pkg_create treats + as flavor).
	${INSTALL_DATA} ${FULLDISTDIR}/tokio-1.52.3.tar.gz \
		${PREFIX}/share/modcargo-crates/tokio-1.52.3.tar.gz
	${INSTALL_DATA_DIR} ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/tokio-1.52.3/deps
	# Prefer rlib; proc-macros emit .so only. [lib] name may differ from package.
	@art=""; \
	for cand in \
		${MODCARGO_TARGET_DIR}/release/deps/libtokio-*.rlib \
		${MODCARGO_TARGET_DIR}/release/libtokio.rlib \
		${MODCARGO_TARGET_DIR}/release/deps/libtokio-*.so \
		${MODCARGO_TARGET_DIR}/release/libtokio.so \
		${MODCARGO_TARGET_DIR}/release/deps/libtokio-*.rmeta \
		${MODCARGO_TARGET_DIR}/release/libtokio.rmeta; do \
		if [ -f "$$cand" ]; then art=$$cand; break; fi; \
	done; \
	if [ -z "$$art" ]; then \
		echo "ERROR: no rlib/so/rmeta for tokio (libtokio.*)" >&2; \
		ls -la ${MODCARGO_TARGET_DIR}/release/ ${MODCARGO_TARGET_DIR}/release/deps/ 2>&1 | head -40 >&2; \
		exit 1; \
	fi; \
	case "$$art" in \
	*.rlib) ext=rlib ;; \
	*.so)   ext=so ;; \
	*.rmeta) ext=rmeta ;; \
	*)      ext=rlib ;; \
	esac; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/tokio-1.52.3/libtokio.$$ext; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/tokio-1.52.3/deps/
	@rmeta=`ls ${MODCARGO_TARGET_DIR}/release/deps/libtokio-*.rmeta 2>/dev/null | head -1`; \
	if [ -n "$$rmeta" ]; then \
		${INSTALL_DATA} $$rmeta \
			${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/tokio-1.52.3/libtokio.rmeta; \
	fi
	@echo "NAME=tokio" > ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/tokio-1.52.3/crate-meta.txt
	@echo "VERSION=1.52.3" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/tokio-1.52.3/crate-meta.txt
	@echo "RUST_LIB=tokio" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/tokio-1.52.3/crate-meta.txt
	@echo "PKGNAME=rust-crate-tokio_1_52_3-0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/tokio-1.52.3/crate-meta.txt
	@echo "PROC_MACRO=0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/tokio-1.52.3/crate-meta.txt

.include <bsd.port.mk>
