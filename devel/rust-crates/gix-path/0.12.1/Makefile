do-build:
	@cd ${WRKDIR}/vendor/gix-path-0.12.1 && \
		${SETENV} ${MAKE_ENV} \
		RUSTC_WRAPPER= \
		CARGO_BUILD_RUSTC_WRAPPER= \
		RUSTFLAGS='--cap-lints=allow' \
		CARGO_ENCODED_RUSTFLAGS='--cap-lints=allow' \
		CARGO_TARGET_DIR=${MODCARGO_TARGET_DIR} \
		CARGO_HOME=${WRKDIR}/cargo-home \
		CARGO_NET_OFFLINE=true \
		${LOCALBASE}/bin/cargo build --release --offline \
			--manifest-path Cargo.toml \
			--config ${WRKDIR}/.cargo/config.toml \
			

do-install:
	${INSTALL_DATA_DIR} ${PREFIX}/share/modcargo-crates
	# Sanitize "+" in installed paths (pkg_create treats + as flavor).
	${INSTALL_DATA} ${FULLDISTDIR}/gix-path-0.12.1.tar.gz \
		${PREFIX}/share/modcargo-crates/gix-path-0.12.1.tar.gz
	${INSTALL_DATA_DIR} ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/gix-path-0.12.1/deps
	# Prefer rlib; proc-macros emit .so only. [lib] name may differ from package.
	@art=""; \
	for cand in \
		${MODCARGO_TARGET_DIR}/release/deps/libgix_path-*.rlib \
		${MODCARGO_TARGET_DIR}/release/libgix_path.rlib \
		${MODCARGO_TARGET_DIR}/release/deps/libgix_path-*.so \
		${MODCARGO_TARGET_DIR}/release/libgix_path.so \
		${MODCARGO_TARGET_DIR}/release/deps/libgix_path-*.rmeta \
		${MODCARGO_TARGET_DIR}/release/libgix_path.rmeta; do \
		if [ -f "$$cand" ]; then art=$$cand; break; fi; \
	done; \
	if [ -z "$$art" ]; then \
		echo "ERROR: no rlib/so/rmeta for gix-path (libgix_path.*)" >&2; \
		ls -la ${MODCARGO_TARGET_DIR}/release/ ${MODCARGO_TARGET_DIR}/release/deps/ 2>&1 | head -40 >&2; \
		exit 1; \
	fi; \
	case "$$art" in \
	*.rlib) ext=rlib ;; \
	*.so)   ext=so ;; \
	*.rmeta) ext=rmeta ;; \
	*)      ext=rlib ;; \
	esac; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/gix-path-0.12.1/libgix_path.$$ext; \
	${INSTALL_DATA} $$art \
		${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/gix-path-0.12.1/deps/
	@rmeta=`ls ${MODCARGO_TARGET_DIR}/release/deps/libgix_path-*.rmeta 2>/dev/null | head -1`; \
	if [ -n "$$rmeta" ]; then \
		${INSTALL_DATA} $$rmeta \
			${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/gix-path-0.12.1/libgix_path.rmeta; \
	fi
	@echo "NAME=gix-path" > ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/gix-path-0.12.1/crate-meta.txt
	@echo "VERSION=0.12.1" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/gix-path-0.12.1/crate-meta.txt
	@echo "RUST_LIB=gix_path" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/gix-path-0.12.1/crate-meta.txt
	@echo "PKGNAME=rust-crate-gix_path_0_12_1-0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/gix-path-0.12.1/crate-meta.txt
	@echo "PROC_MACRO=0" >> ${PREFIX}/lib/rust-crates/${MACHINE_ARCH}/gix-path-0.12.1/crate-meta.txt

.include <bsd.port.mk>
